# Copy this file to .env.local for a local release build. .env.local is ignored by Git.
#
# The bundled free AI service needs no credential here. The upstream key lives
# in a Cloudflare secret, and the model is pinned by the Worker, so neither is
# ever written into the app bundle.
#
# Override the endpoint only to point a local build at a staging Worker.
POLYGLANCE_FREE_AI_ENDPOINT=https://polyglance.ldjx7.dpdns.org/api/free-translate
