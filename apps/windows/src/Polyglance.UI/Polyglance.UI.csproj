<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Polyglance</AssemblyName>
    <Product>Polyglance</Product>
    <Title>Polyglance</Title>
    <AssemblyTitle>Polyglance</AssemblyTitle>
    <Description>Polyglance - 原生跨平台翻译与截图工具</Description>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\Polyglance.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Polyglance.ico" />
    <Resource Include="Resources\Polyglance.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.0" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polyglance.Core\Polyglance.Core.csproj" />
    <ProjectReference Include="..\Polyglance.Platform\Polyglance.Platform.csproj" />
  </ItemGroup>
</Project>
