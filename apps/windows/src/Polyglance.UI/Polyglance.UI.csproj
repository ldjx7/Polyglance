<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Polyglance</AssemblyName>
    <Product>Polyglance</Product>
    <Title>Polyglance</Title>
    <AssemblyTitle>Polyglance</AssemblyTitle>
    <Description>Polyglance - 原生跨平台翻译与截图工具</Description>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\Polyglance.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PolyglanceCliBuild)' == 'true'">
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);POLYGLANCE_CLI</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ExcludeTranslation)' == 'true'">
    <DefineConstants>$(DefineConstants);EXCLUDE_TRANSLATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Polyglance.ico" />
    <Resource Include="Resources\Polyglance.png" />
    <Resource Include="Resources\ProviderIcons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.0" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polyglance.Core\Polyglance.Core.csproj" />
    <ProjectReference Include="..\Polyglance.Platform\Polyglance.Platform.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExcludeOcrModels)' != 'true'">
    <Content Include="models\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PruneSingleFileBundle" BeforeTargets="GenerateSingleFileBundle" Condition="'$(ExcludeOcrModels)' == 'true'">
    <ItemGroup>
      <FilesToBundle Remove="@(FilesToBundle)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('onnxruntime'))" />
      <FilesToBundle Remove="@(FilesToBundle)" Condition="'%(RelativePath)' == 'Microsoft.ML.OnnxRuntime.dll'" />
    </ItemGroup>
  </Target>
</Project>
