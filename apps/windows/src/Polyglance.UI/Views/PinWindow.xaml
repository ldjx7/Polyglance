<Window x:Class="Polyglance.UI.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Polyglance.UI.Controls"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseUp="OnMouseUp"
        MouseWheel="OnMouseWheel"
        MouseDoubleClick="OnMouseDoubleClick"
        KeyDown="OnKeyDown"
        Activated="OnActivated"
        Deactivated="OnDeactivated"
        Focusable="True">
    <Border x:Name="ContainerBorder" Margin="8" Background="#FFFFFF" BorderBrush="#20000000" BorderThickness="1" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect x:Name="Shadow" BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <Grid x:Name="PinSurface">
                <Image x:Name="PinImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Canvas x:Name="AnnotationCanvas" ClipToBounds="True"/>
                <Canvas x:Name="AnnotationSelectionCanvas" ClipToBounds="True" IsHitTestVisible="False"/>
                <Border x:Name="ZoomBadge"
                        Background="#BF000000"
                        CornerRadius="8"
                        Padding="12,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ZoomBadgeText"
                               Text="100%"
                               Foreground="#FFFFFF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>
                <Border x:Name="CopyBadge"
                        Background="#BF000000"
                        CornerRadius="4"
                        Padding="8,4"
                        Margin="0,8,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <TextBlock Text="已复制"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="Normal"
                               HorizontalAlignment="Center"/>
                </Border>
                <!-- Text Selection Capsule Menu (PixPin Style) -->
                <Border x:Name="TextCapsuleBar"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#FAFFFFFF"
                        BorderBrush="#1F000000"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="6,3"
                        Visibility="Collapsed"
                        Panel.ZIndex="100">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                    </Border.Effect>
                    <Border.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#262626"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#14000000"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1F000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnCapsuleCopy" Content="复制" ToolTip="复制文本" Click="OnCapsuleCopyClick"/>
                        <Rectangle Width="1" Height="14" Fill="#1F000000" Margin="2,0"/>
                        <Button x:Name="BtnCapsuleHighlight" Content="荧光笔" ToolTip="荧光高亮" Click="OnCapsuleHighlightClick"/>
                        <Button x:Name="BtnCapsuleWavy" Content="波浪线" ToolTip="波浪下划线" Click="OnCapsuleWavyClick"/>
                        <Button x:Name="BtnCapsuleLine" Content="直线" ToolTip="直线" Click="OnCapsuleLineClick"/>
                        <Button x:Name="BtnCapsuleStrikethrough" Content="删除线" ToolTip="删除线" Click="OnCapsuleStrikethroughClick"/>
                        <Rectangle Width="1" Height="14" Fill="#1F000000" Margin="2,0"/>
                        <Button x:Name="BtnCapsuleTranslate" Content="翻译" ToolTip="翻译选中文本" Click="OnCapsuleTranslateClick"/>
                    </StackPanel>
                </Border>
            </Grid>
            <controls:ScreenshotToolbar x:Name="AnnotationToolbar"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0"/>
        </StackPanel>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="UndoAnnotationMenuItem" Header="撤销标注" InputGestureText="Ctrl+Z" Click="OnUndoAnnotationClick" IsEnabled="False"/>
                <MenuItem x:Name="AnnotationMenuItem" Header="标注" Click="OnAnnotationClick"/>
                <MenuItem Header="复制图片 (Copy)" Click="OnCopyClick"/>
                <MenuItem Header="保存图片 (Save)..." Click="OnSaveClick"/>
                <Separator/>
                <MenuItem x:Name="ColorPickerMenuItem" Header="取色" Click="OnColorPickerClick"/>
                <MenuItem x:Name="OcrMenuItem" Header="文字识别 (OCR)" Click="OnOcrClick"/>
                <MenuItem x:Name="TranslateMenuItem" Header="截图翻译" Click="OnTranslateClick"/>
                <Separator/>
                <MenuItem Header="透明度 (Opacity)">
                    <MenuItem Header="100% (默认)" Click="OnSetOpacity100"/>
                    <MenuItem Header="80%" Click="OnSetOpacity80"/>
                    <MenuItem Header="60%" Click="OnSetOpacity60"/>
                    <MenuItem Header="40%" Click="OnSetOpacity40"/>
                </MenuItem>
                <MenuItem Header="总在最前 (Topmost)" IsCheckable="True" IsChecked="True" Click="OnToggleTopmostClick"/>
                <MenuItem Header="阴影效果 (Shadow)" IsCheckable="True" IsChecked="True" Click="OnToggleShadowClick"/>
                <Separator/>
                <MenuItem Header="关闭贴图 (Close)" Click="OnCloseClick"/>
            </ContextMenu>
        </Border.ContextMenu>
    </Border>
</Window>
