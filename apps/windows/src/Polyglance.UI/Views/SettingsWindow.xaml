                                            <ui:PasswordBox x:Name="TxtYoudaoSecret" PlaceholderText="平台生成的密钥" Height="32" Padding="8,0,32,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="前往有道智云平台 (ai.youdao.com) 注册开通自然语言翻译服务获取。" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- 火山翻译 -->
                                        <StackPanel x:Name="FormVolcano" Visibility="Collapsed">
                                            <TextBlock Text="AccessKey ID" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:TextBox x:Name="TxtVolcanoAccessKey" PlaceholderText="火山引擎 AccessKey ID" Height="32" Padding="8,0,8,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Secret AccessKey" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:PasswordBox x:Name="TxtVolcanoSecretKey" PlaceholderText="火山引擎 Secret AccessKey (或 Bearer Token)" Height="32" Padding="8,0,32,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="前往火山引擎控制台 (volcengine.com) 申请机器翻译 API 密钥。" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- OpenAI 兼容 / 自定义 AI -->
                                        <StackPanel x:Name="FormOpenAi" Visibility="Collapsed">
                                            <TextBlock x:Name="LblCustomAiName" Text="服务名称" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" Visibility="Collapsed"/>
                                            <ui:TextBox x:Name="TxtCustomAiName" PlaceholderText="例如 DeepSeek, Claude 等" Height="32" Padding="8,0,8,0" VerticalContentAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed" TextChanged="OnCustomAiNameChanged"/>
                                            <TextBlock x:Name="TxtCustomAiNameError" Text="服务名称已存在，请保持唯一" FontSize="10.5" Foreground="#FF3B30" Margin="0,0,0,8" Visibility="Collapsed"/>

                                            <TextBlock Text="服务地址 (Endpoint)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:TextBox x:Name="TxtEndpoint" PlaceholderText="https://api.openai.com/v1" Height="32" Padding="8,0,8,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="API 密钥 (API Key)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:PasswordBox x:Name="TxtApiKey" PlaceholderText="sk-..." Height="32" Padding="8,0,32,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="模型名称" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:TextBox x:Name="TxtModel" PlaceholderText="例如 deepseek-chat, gpt-4o-mini" Height="32" Padding="8,0,8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                                            <TextBlock x:Name="LblCustomAiPrompt" Text="自定义 Prompt (可选)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" Visibility="Collapsed"/>
                                            <ui:TextBox x:Name="TxtCustomAiPrompt" PlaceholderText="支持变量替换：{target_language}、{source_language}。留空则使用系统默认翻译提示词。" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="120" Padding="8,6" Margin="0,0,0,4" Visibility="Collapsed"/>
                                            <TextBlock x:Name="TxtCustomAiPromptHint" Text="支持变量替换：{target_language}、{source_language}。留空则使用系统默认翻译提示词。" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                                            <ui:ToggleSwitch x:Name="ChkAiStreaming" Content="开启 AI 流式逐字输出" IsChecked="True" Click="OnAiStreamingOpenAiClick" Margin="0,0,0,12"/>

                                            <ui:Button x:Name="BtnDeleteCustomAi" Appearance="Danger" Content="删除该自定义 AI 服务" Padding="14,4" HorizontalAlignment="Left" Click="OnDeleteCustomAiClick" Visibility="Collapsed"/>
                                        </StackPanel>

                                        <!-- 内置系统网络服务 (Microsoft, Google) -->
                                        <StackPanel x:Name="FormBuiltin" Visibility="Collapsed">
                                            <TextBlock Text="该服务内置系统网络协议，无需额外参数。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <Separator Grid.Row="1" Margin="0,12,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                                <!-- 底部撤销与保存按钮 -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Appearance="Secondary" Content="撤销" Padding="18,5" Margin="0,0,8,0" Click="OnCancelProviderSettingsClick"/>
                                    <ui:Button Appearance="Primary" Content="保存" Padding="18,5" Click="OnSaveClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 分类 2: 文本识别 (OCR) -->
                    <Grid x:Name="ViewServiceOcr" Grid.Row="1" Visibility="Collapsed">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="16" Background="#180D9488" Margin="0,0,0,14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ScanType24" FontSize="28" Foreground="#0D9488" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Windows Media OCR 离线文字识别" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="由 Windows 系统原生 OCR 引擎支持，支持多语言离线高精度识别，免配置开箱即用。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" Margin="0,8,0,14" HorizontalAlignment="Center"/>
                                <Border Background="#1810B981" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                                    <TextBlock Text="内置生效" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 分类 3: 语音合成 (TTS) -->
                    <Grid x:Name="ViewServiceTts" Grid.Row="1" Visibility="Collapsed">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="16" Background="#184F46E5" Margin="0,0,0,14" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="28" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Windows SAPI 离线语音合成" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="由 Windows 系统语音合成服务提供支持，内置高品质多国语言发音人，免配置开箱即用。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" Margin="0,8,0,14" HorizontalAlignment="Center"/>
                                <Border Background="#1810B981" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                                    <TextBlock Text="内置生效" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 分类 4: 偏好设置 -->
                    <Grid x:Name="ViewServicePreferences" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <StackPanel>
                                <!-- 默认翻译服务 -->
                                <ui:Card Margin="0,0,0,10" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="默认翻译服务" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="选择截屏、划词与主面板翻译的默认服务商" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbProvider" Grid.Column="1" Width="190" Height="32" VerticalContentAlignment="Center" Padding="8,0,24,0" FontSize="12.5">
                                            <ComboBoxItem Tag="freeai">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Polyglance;component/Resources/ProviderIcons/free-ai.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="官方 AI (免费内置)" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="microsoft">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Polyglance;component/Resources/ProviderIcons/microsoft.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Microsoft (免费内置)" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="google">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Polyglance;component/Resources/ProviderIcons/google.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Google (免费内置)" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="deepl">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Polyglance;component/Resources/ProviderIcons/deepl.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="DeepL" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="baidu">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Polyglance;component/Resources/ProviderIcons/baidu.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="百度翻译" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="youdao">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Polyglance;component/Resources/ProviderIcons/youdao.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="有道翻译" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="volcano">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Polyglance;component/Resources/ProviderIcons/volcano.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="火山翻译" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="openaicompatible">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Polyglance;component/Resources/ProviderIcons/openai.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="OpenAI 兼容协议" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                </ui:Card>

                                <!-- 默认目标语言 -->
                                <ui:Card Margin="0,0,0,10" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="默认目标语言" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="未指定语种时翻译结果的目标语言" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbTargetLang" Grid.Column="1" Width="190" Height="32" VerticalContentAlignment="Center" Padding="10,0,24,0" FontSize="12.5" SelectedIndex="0">
                                            <ComboBoxItem Content="中文 (简体)" Tag="zh-Hans"/>
                                            <ComboBoxItem Content="英语 (EN)" Tag="en"/>
                                            <ComboBoxItem Content="日语 (JA)" Tag="ja"/>
                                            <ComboBoxItem Content="韩语 (KO)" Tag="ko"/>
                                            <ComboBoxItem Content="法语 (FR)" Tag="fr"/>
                                            <ComboBoxItem Content="德语 (DE)" Tag="de"/>
                                            <ComboBoxItem Content="西班牙语" Tag="es"/>
                                            <ComboBoxItem Content="俄语 (RU)" Tag="ru"/>
                                        </ComboBox>
                                    </Grid>
                                </ui:Card>

                                <!-- 备用目标语言 -->
                                <ui:Card Margin="0,0,0,10" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="备用目标语言 (输入母语时互译)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="当划词文本与默认目标语言相同时自动翻译为此语言" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbSecondTargetLang" Grid.Column="1" Width="190" Height="32" VerticalContentAlignment="Center" Padding="10,0,24,0" FontSize="12.5" SelectedIndex="1">
                                            <ComboBoxItem Content="中文 (简体)" Tag="zh-Hans"/>
                                            <ComboBoxItem Content="英语 (EN)" Tag="en"/>
                                            <ComboBoxItem Content="日语 (JA)" Tag="ja"/>
                                            <ComboBoxItem Content="韩语 (KO)" Tag="ko"/>
                                            <ComboBoxItem Content="法语 (FR)" Tag="fr"/>
                                            <ComboBoxItem Content="德语 (DE)" Tag="de"/>
                                            <ComboBoxItem Content="西班牙语" Tag="es"/>
                                            <ComboBoxItem Content="俄语 (RU)" Tag="ru"/>
                                        </ComboBox>
                                    </Grid>
                                </ui:Card>

                                <!-- 截图翻译风格 -->
                                <ui:Card Margin="0,0,0,10" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="截图翻译风格" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Bob 风格在独立窗口中呈现多引擎翻译；有道风格在原图位置覆盖译文" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbScreenshotTranslationStyle" Grid.Column="1" Width="220" Height="32" VerticalContentAlignment="Center" Padding="10,0,24,0" FontSize="12.5" SelectedIndex="0">
                                            <ComboBoxItem Content="Bob 风格 (独立窗口识别翻译)" Tag="bob"/>
                                            <ComboBoxItem Content="有道风格 (原图覆盖译文)" Tag="youdao"/>
                                        </ComboBox>
                                    </Grid>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 收藏夹 (Favorites) -->
                <Grid x:Name="PanelFavorites" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧列表 -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,12,0"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ui:TextBox x:Name="TxtFavoriteSearch"
                                        Grid.Row="0"
                                        PlaceholderText="搜索收藏记录…"
                                        Icon="{ui:SymbolIcon Search24}"
                                        Height="32"
                                        Margin="0,0,0,8"
                                        TextChanged="OnFavoriteSearchTextChanged"/>
                            <ListBox x:Name="ListFavorites"
                                     Grid.Row="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     SelectionChanged="OnFavoriteSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding SourceText}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TargetText}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,3"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='MM-dd HH:mm'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding Provider}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyFavoritesNotice" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="Star24" FontSize="26" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="暂无收藏内容" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧详情卡片 -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <ScrollViewer x:Name="FavoriteDetailPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtFavoriteTime" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" Width="28" Height="28" Padding="0" Margin="0,0,6,0" ToolTip="删除记录" Click="OnDeleteFavoriteClick"/>
                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Star24}" Foreground="#EAB308" Width="28" Height="28" Padding="0" ToolTip="取消收藏" Click="OnUnfavoriteClick"/>
                                        </StackPanel>
                                    </Grid>
                                    <ui:Card Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBox x:Name="TxtFavoriteSource" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Copy20}" Width="24" Height="24" Padding="0" ToolTip="复制原文" Click="OnCopyFavoriteSourceClick"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ui:Card>
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                            <TextBlock x:Name="TxtFavoriteSourceLang" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                        <ui:SymbolIcon Symbol="ChevronRight16" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                            <TextBlock x:Name="TxtFavoriteTargetLang" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <ui:Card Padding="12">
                                        <StackPanel>
                                            <TextBox x:Name="TxtFavoriteTarget" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Grid Margin="0,8,0,0">
                                                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Copy20}" Width="24" Height="24" Padding="0" ToolTip="复制译文" HorizontalAlignment="Left" Click="OnCopyFavoriteTargetClick"/>
                                                <TextBlock x:Name="TxtFavoriteProvider" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </ui:Card>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock x:Name="TxtFavoriteEmptySelection" Text="请在左侧选择一条记录" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 历史记录 (History) -->
                <Grid x:Name="PanelHistory" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧列表 -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,12,0"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtHistorySearch"
                                            Grid.Column="0"
                                            PlaceholderText="搜索历史记录…"
                                            Icon="{ui:SymbolIcon Search24}"
                                            Height="32"
                                            TextChanged="OnHistorySearchTextChanged"/>
                                <ui:Button Grid.Column="1" Content="清空" Appearance="Transparent" Padding="8,4" Margin="4,0,0,0" ToolTip="清空所有记录" Click="OnClearHistoryClick"/>
                            </Grid>
                            <ListBox x:Name="ListHistory"
                                     Grid.Row="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     SelectionChanged="OnHistorySelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding SourceText}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TargetText}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,3"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='MM-dd HH:mm'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding Provider}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyHistoryNotice" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="History24" FontSize="26" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="暂无历史记录" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧详情卡片 -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <ScrollViewer x:Name="HistoryDetailPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtHistoryTime" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" Width="28" Height="28" Padding="0" Margin="0,0,6,0" ToolTip="删除记录" Click="OnDeleteHistoryClick"/>
                                            <ui:Button x:Name="BtnToggleFavoriteHistory" Appearance="Transparent" Icon="{ui:SymbolIcon Star24}" Width="28" Height="28" Padding="0" ToolTip="收藏/取消收藏" Click="OnToggleFavoriteHistoryClick"/>
                                        </StackPanel>
                                    </Grid>
                                    <ui:Card Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBox x:Name="TxtHistorySource" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Copy20}" Width="24" Height="24" Padding="0" ToolTip="复制原文" Click="OnCopyHistorySourceClick"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ui:Card>
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                            <TextBlock x:Name="TxtHistorySourceLang" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                        <ui:SymbolIcon Symbol="ChevronRight16" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                            <TextBlock x:Name="TxtHistoryTargetLang" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <ui:Card Padding="12">
                                        <StackPanel>
                                            <TextBox x:Name="TxtHistoryTarget" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Grid Margin="0,8,0,0">
                                                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Copy20}" Width="24" Height="24" Padding="0" ToolTip="复制译文" HorizontalAlignment="Left" Click="OnCopyHistoryTargetClick"/>
                                                <TextBlock x:Name="TxtHistoryProvider" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </ui:Card>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock x:Name="TxtHistoryEmptySelection" Text="请在左侧选择一条记录" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- OCR 设置 (OcrSettings) -->
                <Grid x:Name="PanelOcrSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel>
                            <ui:Card Margin="0,0,0,10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="默认文字排版" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="选择 OCR 提取多行文本时的换行合并偏好" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbOcrFormatting" Grid.Column="1" Width="200" Height="32" VerticalContentAlignment="Center" Padding="10,0,24,0" FontSize="12.5" SelectedIndex="0">
                                        <ComboBoxItem Content="保留段落换行" Tag="0"/>
                                        <ComboBoxItem Content="合并所有换行（单行）" Tag="1"/>
                                        <ComboBoxItem Content="严格保留原有换行" Tag="2"/>
                                    </ComboBox>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="文字识别完成后自动复制到剪贴板" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="完成文本识别后自动将格式化结果存入系统剪贴板" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ToggleOcrAutoCopy" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>


                <!-- 3. 快捷键 (Shortcuts) -->
                <Grid x:Name="PanelShortcuts" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,12,10">
                        <ui:Button Content="恢复默认" Appearance="Secondary" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,4" Click="OnResetShortcutsClick"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel>
                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="截图并贴图 (Screenshot &amp; Pin)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="触发屏幕划选，支持画笔标注与固定置顶" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyScreenshotPin" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="截图并复制 (Screenshot &amp; Copy)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="激活截图区域，框选之后直接复制到剪贴板，不显示工具栏菜单" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyScreenshotCopy" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="贴出剪贴板图片 (Pin Clipboard)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="将剪贴板中的图片作为置顶贴图显示" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyPinClipboardImage" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="截图翻译 (Screenshot Translate)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="框选屏幕进行翻译；可在服务设置中选择 Bob 风格或有道原图覆盖风格" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyScreenTranslate" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="文字识别 (OCR Workspace)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="框选屏幕唤起文字识别工作台，支持排版与二次加工" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyOcrWorkspace" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="双语对照卡 (Bilingual Card)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="框选屏幕识别并生成双语对照置顶结果卡" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyOcrTranslationCard" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="打开主翻译面板 (Main Translator)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="打开双栏翻译控制台（自动填入剪贴板文本）" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyMainTranslator" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="全局划词/选中文本即时翻译 (Quick Selection)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="抓取任意应用当前选中文本并即时弹出翻译" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeySelectedText" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="划词翻译并替换 (Translate &amp; Replace)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="抓取选中文本直接原地替换为译文，不弹出翻译窗口" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyTranslateAndReplace" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="滚动长截图会话 (Scrolling Stitcher)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="触发 Rust 驱动的超长网页与文档滚动截图拼接" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyLongScreenshot" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="区域录屏 (Screen Recording)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="框选区域并进入录屏工具栏" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyScreenRecording" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="恢复最近贴图 (Restore Pin)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="恢复最近一次保存到贴图历史的图片" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <controls:ShortcutRecorderControl x:Name="RecHotkeyRestoreMostRecentPin" Grid.Column="1" VerticalAlignment="Center" MinWidth="130"/>
                                </Grid>
                            </ui:Card>

                            <!-- 主窗口内固定快捷键说明 -->
                            <ui:Card Padding="16,12" Margin="0,6,0,0" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
                                <StackPanel>
                                    <TextBlock Text="主窗口内快捷键（固定）" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="翻译输入内容" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="Ctrl + Enter" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="复制译文结果" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="Ctrl + Shift + C" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="清空并聚焦原文" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="Ctrl + K" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 5. 录屏与工具栏 (Toolbar) -->
                <Grid x:Name="PanelToolbar" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,12,10">
                        <ui:Button x:Name="BtnResetToolbarItems" Appearance="Secondary" Content="恢复默认" HorizontalAlignment="Right" Padding="14,4" Click="OnResetToolbarItemsClick" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel>
                            <!-- 录屏参数 -->
                            <ui:Card Margin="0,0,0,10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="默认录屏格式" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="录制结束后导出的默认视频或动图格式" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultRecordFormat" Grid.Column="1" Width="160" Height="32" VerticalContentAlignment="Center" Padding="10,0,24,0" FontSize="12.5" SelectedIndex="0">
                                        <ComboBoxItem Content="MP4 视频" Tag="MP4"/>
                                        <ComboBoxItem Content="GIF 动图" Tag="GIF"/>
                                    </ComboBox>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="默认录屏帧率" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="更高帧率画面更流畅，文件体积相应增加" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultRecordFps" Grid.Column="1" Width="160" Height="32" VerticalContentAlignment="Center" Padding="10,0,24,0" FontSize="12.5" SelectedIndex="0">
                                        <ComboBoxItem Content="60 FPS" Tag="60"/>
                                        <ComboBoxItem Content="30 FPS" Tag="30"/>
                                        <ComboBoxItem Content="15 FPS" Tag="15"/>
                                    </ComboBox>
                                </Grid>
                            </ui:Card>

                            <ui:Card Padding="16,14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="录制倒计时" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="点击开始录制后预留的准备延时" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultRecordDelay" Grid.Column="1" Width="160" Height="32" VerticalContentAlignment="Center" Padding="10,0,24,0" FontSize="12.5" SelectedIndex="0">
                                        <ComboBoxItem Content="无延时" Tag="0"/>
                                        <ComboBoxItem Content="3 秒" Tag="3"/>
                                        <ComboBoxItem Content="5 秒" Tag="5"/>
                                        <ComboBoxItem Content="10 秒" Tag="10"/>
                                    </ComboBox>
                                </Grid>
                            </ui:Card>
                            <!-- 实时生效工具栏卡片 -->
                            <ui:Card Margin="0,0,0,12" Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="生效工具栏" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="（支持拖拽排序，点击右上角移除）" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtActiveToolbarCount" Text="已启用 19 / 19" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Background="#FFFFFF" BorderBrush="#14000000" BorderThickness="1" CornerRadius="18" Padding="8,5" HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="2" Direction="270"/>
                                        </Border.Effect>
                                        <ItemsControl x:Name="PreviewToolbarItems">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="CapsuleItemRoot" Margin="1.5,0" Cursor="Hand" ToolTip="{Binding DisplayName}"
                                                          PreviewMouseLeftButtonDown="OnCapsuleItemMouseDown"
                                                          MouseMove="OnCapsuleItemMouseMove"
                                                          MouseLeftButtonUp="OnCapsuleItemMouseUp"
                                                          Tag="{Binding}"
                                                          Opacity="{Binding CapsuleOpacity}">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding CapsuleScale}" ScaleY="{Binding CapsuleScale}" CenterX="13" CenterY="13"/>
                                                        </Grid.RenderTransform>
                                                        <Border Width="26" Height="26" Background="#0A000000" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Path Data="{Binding IconData}" Width="12.5" Height="12.5" Stretch="Uniform" Fill="{Binding IconBrush}" Stroke="{Binding IconStrokeBrush}" StrokeThickness="{Binding StrokeThickness}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Button x:Name="BtnRemoveCapsule" Width="13" Height="13" Margin="0,-2,-2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Background="#EF4444" BorderThickness="0" Click="OnRemoveToolbarItemClick" Tag="{Binding}" ToolTip="移除" Visibility="Collapsed">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6.5">
                                                                        <Path Data="M3,3 L7,7 M7,3 L3,7" Stroke="#FFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="8" Stretch="Uniform"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="CapsuleItemRoot" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnRemoveCapsule" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </ui:Card>

                            <!-- 功能储备池卡片 -->
                            <ui:Card Margin="0,0,0,10" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="功能储备池" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="点击卡片即可在工具栏中添加或移除该功能" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12"/>

                                    <ItemsControl x:Name="ListToolbarItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="3,4" CornerRadius="8" BorderThickness="1"
                                                        Background="{Binding CardBackgroundBrush}"
                                                        BorderBrush="{Binding CardBorderBrush}"
                                                        Padding="7,7" Cursor="Hand"
                                                        MouseLeftButtonUp="OnToolbarCardClick"
                                                        Tag="{Binding}">
                                                    <Grid Height="28">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="5" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,5,0">
                                                            <Path Data="{Binding IconData}" Width="12.5" Height="12.5" Stretch="Uniform" Fill="{Binding IconBrush}" Stroke="{Binding IconStrokeBrush}" StrokeThickness="{Binding StrokeThickness}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{Binding TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="2" Width="15" Height="15" CornerRadius="3.5" Background="{Binding BadgeBackgroundBrush}" BorderBrush="{Binding BadgeBorderBrush}" BorderThickness="{Binding BadgeBorderThickness}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0,0,0">
                                                            <Path Data="{Binding BadgeIconData}" Stroke="{Binding BadgeStrokeBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 6. 更新与关于 (About) -->
                <Grid x:Name="PanelAbout" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel>
                            <!-- 检查版本更新 -->
                            <ui:Card Margin="0,0,0,12" Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Polyglance 版本" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeVersionType" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="#1A0A84FF" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtVersionType" Text="正式版" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF0A84FF"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtCurrentVersion" Text="v0.0.5" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ui:Button x:Name="BtnCheckUpdate" Grid.Column="1" Appearance="Secondary" Content="立即检查更新" Padding="14,6" Click="OnCheckUpdateClick"/>
                                    </Grid>

                                    <!-- 发现新版本卡片 -->
                                    <Border x:Name="BorderAvailableUpdate" Visibility="Collapsed" Margin="0,0,0,12" Padding="12" CornerRadius="6" Background="#0A0A84FF" BorderBrush="#200A84FF" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtNewVersionTitle" Text="发现新版本" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border x:Name="BadgeNewVersionType" Margin="6,0,0,0" Padding="5,1" CornerRadius="4" Background="#200A84FF" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtNewVersionType" Text="正式版" FontSize="10" FontWeight="SemiBold" Foreground="#FF0A84FF"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <ui:Button x:Name="BtnSkipVersion" Appearance="Secondary" Content="跳过此版本" Margin="0,0,6,0" Padding="8,3" FontSize="11" Click="OnSkipVersionClick"/>
                                                    <ui:Button x:Name="BtnApplyUpdate" Appearance="Primary" Content="立即更新并重启" Padding="10,3" FontSize="11" Click="OnApplyUpdateClick"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="TxtReleaseNotes" Text="" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxHeight="100"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="TxtUpdateStatus" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" Visibility="Collapsed"/>
                                    <ProgressBar x:Name="PbUpdateProgress" Height="4" Margin="0,0,0,10" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>

                                    <Separator Margin="0,6,0,10" Background="{DynamicResource CardStrokeColorDefaultBrush}" Height="1"/>

                                    <!-- 更新通道切换开关 -->
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="接收测试版更新 (Beta Channel)" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="开启后优先接收包含实验性新特性的测试版本；关闭后仅接收稳定的正式版。" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="SwIncludeBetaUpdates" Grid.Column="1" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- 关于 Polyglance -->
                            <ui:Card Padding="24,28">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="56" Height="56" CornerRadius="16" Background="#0A84FF" Margin="0,0,0,12" HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#0A84FF"/>
                                        </Border.Effect>
                                        <TextBlock Text="P" FontWeight="Black" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Polyglance" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAboutVersion" Text="v0.0.4" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,10"/>
                                    <TextBlock Text="多语言内容，一眼看懂" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="基于 Rust 共享内核的原生跨平台翻译与截图工具" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Grid>
</ui:FluentWindow>
