<ui:FluentWindow x:Class="Polyglance.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Polyglance.UI.Controls"
        mc:Ignorable="d"
        Title="偏好设置 - Polyglance"
        Width="940" Height="630"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Indicator"
                                        Width="3.5"
                                        Height="18"
                                        HorizontalAlignment="Left"
                                        Background="#0A84FF"
                                        CornerRadius="2"
                                        Visibility="Collapsed"
                                        Margin="-6,0,0,0"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0D000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#180A84FF"/>
                                <Setter Property="Foreground" Value="#0A84FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0A000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0A84FF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="偏好设置" Icon="pack://application:,,,/Polyglance;component/Resources/Polyglance.ico" Height="38"/>

        <!-- 主体布局：左侧导航 + 右侧内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10,12,10,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部 Branding (对齐 Mac) -->
                    <StackPanel Grid.Row="0" Margin="4,2,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Polyglance;component/Resources/Polyglance.ico" Width="26" Height="26" Margin="0,0,8,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Polyglance" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="原生多源翻译与屏幕工具" FontSize="9.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Separator Margin="0,10,0,4" Opacity="0.3"/>
                    </StackPanel>

                    <!-- 分类导航项 (可滚动) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 1. 翻译 Section -->
                            <TextBlock Text="翻译" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,4,0,3"/>

                            <RadioButton x:Name="NavTranslation" Style="{StaticResource NavItemStyle}" Tag="Translation" Click="OnNavChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="翻译设置" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavFavorites" Style="{StaticResource NavItemStyle}" Tag="Favorites" Click="OnNavChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Star24" FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="收藏夹" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavHistory" Style="{StaticResource NavItemStyle}" Tag="History" Click="OnNavChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="History24" FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="历史记录" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. OCR Section -->
                            <TextBlock Text="OCR" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,10,0,3"/>

                            <RadioButton x:Name="NavOcrSettings" Style="{StaticResource NavItemStyle}" Tag="OcrSettings" Click="OnNavChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="OCR 设置" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. 通用 Section -->
                            <TextBlock Text="通用" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,10,0,3"/>

                            <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItemStyle}" IsChecked="True" Tag="General" Click="OnNavChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="通用设置" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavItemStyle}" Tag="Shortcuts" Click="OnNavChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="快捷键" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavToolbar" Style="{StaticResource NavItemStyle}" Tag="Toolbar" Click="OnNavChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Toolbox24" FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="录屏与工具栏" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItemStyle}" Tag="About" Click="OnNavChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="关于" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部版本信息 -->
                    <TextBlock x:Name="TxtSidebarVersion" Grid.Row="2" Text="版本 v0.0.4" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,8,0,0"/>
                </Grid>
            </Border>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1" Margin="20,12,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部统一 HeaderBar (对齐 Mac) -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtHeaderTitle" Text="通用设置" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="系统权限、启动项与基础偏好" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusMessage" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                        <ui:Button Appearance="Primary" Content="保存设置" Padding="20,6" Click="OnSaveClick"/>
                    </StackPanel>
                </Grid>

                <!-- 面板切换容器 -->
                <Grid Grid.Row="1">
                <!-- 1. 通用 (General) -->
                <Grid x:Name="PanelGeneral" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel>
                            <ui:Card Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Power24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="开机时自动启动 Polyglance" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="登录 Windows 后在后台静默启动，并驻留系统托盘" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ChkLaunchAtLogin" Grid.Column="2" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="AppGeneric24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="关闭主窗口时最小化到系统托盘" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="点击主窗口关闭按钮时继续在后台保持运行" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ChkMinimizeToTray" Grid.Column="2" VerticalAlignment="Center" IsChecked="True"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="History24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="保存已完成截图到历史记录" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="开启后，成功复制或另存为的截图与长截图将自动存入历史记录" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ToggleSaveCompletedScreenshotsToHistory" Grid.Column="2" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 2. 翻译设置 (Translation) -->
                <Grid x:Name="PanelTranslation" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部服务分类切换胶囊 (对齐 Mac) -->
                    <Border Grid.Row="0" Background="#0A000000" CornerRadius="8" Padding="3" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabServiceTranslation" Style="{StaticResource SegmentTabStyle}" Content="文本翻译" IsChecked="True" Click="OnServiceCategoryChanged"/>
                            <RadioButton x:Name="TabServiceOcr" Style="{StaticResource SegmentTabStyle}" Content="文本识别" Click="OnServiceCategoryChanged"/>
                            <RadioButton x:Name="TabServiceTts" Style="{StaticResource SegmentTabStyle}" Content="语音合成" Click="OnServiceCategoryChanged"/>
                            <RadioButton x:Name="TabServicePreferences" Style="{StaticResource SegmentTabStyle}" Content="偏好设置" Click="OnServiceCategoryChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 分类 1: 文本翻译 (双栏 Master-Detail) -->
                    <Grid x:Name="ViewServiceTranslation" Grid.Row="1" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧服务列表 -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox x:Name="ListServiceProviders"
                                         Grid.Row="0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False"
                                         VirtualizingPanel.IsVirtualizing="False"
                                         SelectionChanged="OnProviderSelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="Margin" Value="4,1"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1F0078D7"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsSelected" Value="True"/>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="Background" Value="#2E0078D7"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="34" Margin="0,2" Background="Transparent"
                                                  PreviewMouseLeftButtonDown="OnProviderItemPreviewMouseDown"
                                                  MouseMove="OnProviderItemMouseMove"
                                                  PreviewMouseLeftButtonUp="OnProviderItemMouseUp">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0" Source="{Binding IconPath}" Width="18" Height="18" Margin="4,0,8,0" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                                <!-- 徽章 (内置 / 秘钥) -->
                                                <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="8" Padding="5,1" VerticalAlignment="Center" Margin="4,0,10,0">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                                                </Border>

                                                <!-- 启用/禁用 Switch -->
                                                <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Focusable="False" Click="OnProviderToggleClick" Tag="{Binding}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,2,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Separator Grid.Row="1" Margin="0" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                                <!-- 底部工具条 (+ - 默认排序) -->
                                <Grid Grid.Row="2" Margin="8,6,8,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="BtnAddProvider" Appearance="Transparent" Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="启用服务" Click="OnAddProviderMenuClick">
                                            <ui:SymbolIcon Symbol="Add16" FontSize="12"/>
                                        </ui:Button>
                                        <ui:Button Appearance="Transparent" Width="26" Height="26" Padding="0" ToolTip="禁用选中服务" Click="OnRemoveProviderClick">
                                            <ui:SymbolIcon Symbol="Subtract16" FontSize="12"/>
                                        </ui:Button>
                                    </StackPanel>
                                    <ui:Button Appearance="Transparent" Content="默认排序" FontSize="11.5" Foreground="#0A84FF" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2" Click="OnResetProviderOrderClick" ToolTip="恢复默认顺序（官方 AI 在首位）"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 右侧详细配置卡片 -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <StackPanel>
                                        <!-- 头部：图标 + 标题 + 副标题 -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image x:Name="ImgSelectedProvider" Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSelectedProviderTitle" Text="官方 AI" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock x:Name="TxtSelectedProviderSubtitle" Text="官方内置 AI 翻译服务，无需配置密钥" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Margin="0,0,0,14" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                                        <!-- 官方 AI -->
                                        <StackPanel x:Name="FormFreeAi" Visibility="Collapsed">
                                            <TextBlock Text="官方 AI 翻译服务，无需配置任何 API Key，由 Polyglance 统一内置支持。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                            <ui:ToggleSwitch x:Name="ChkAiStreamingFreeAi" Content="开启 AI 流式逐字输出" IsChecked="True" Click="OnAiStreamingFreeAiClick"/>
                                        </StackPanel>

                                        <!-- DeepL -->
                                        <StackPanel x:Name="FormDeepl" Visibility="Collapsed">
                                            <TextBlock Text="Auth Key" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:PasswordBox x:Name="TxtDeeplAuthKey" PlaceholderText="00000000-0000-0000-0000-000000000000:fx" Height="32" Padding="8,0,32,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="接口地址 (可选)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:TextBox x:Name="TxtDeeplEndpoint" PlaceholderText="留空自动匹配 Free/Pro 官方地址" Height="32" Padding="8,0,8,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="前往 DeepL 开发平台 (deepl.com) 注册获取 Auth Key，支持免费版与付费版。" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- 百度翻译 -->
                                        <StackPanel x:Name="FormBaidu" Visibility="Collapsed">
                                            <TextBlock Text="APP ID" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:TextBox x:Name="TxtBaiduAppId" PlaceholderText="百度翻译开放平台 AppID" Height="32" Padding="8,0,8,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="密钥 (Secret Key)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:PasswordBox x:Name="TxtBaiduSecretKey" PlaceholderText="平台生成的密钥" Height="32" Padding="8,0,32,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="前往百度翻译开放平台 (fanyi-api.baidu.com) 注册开通通用翻译 API 获取。" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- 有道翻译 -->
                                        <StackPanel x:Name="FormYoudao" Visibility="Collapsed">
                                            <TextBlock Text="应用 ID (AppKey)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:TextBox x:Name="TxtYoudaoAppKey" PlaceholderText="有道智云 AppKey" Height="32" Padding="8,0,8,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
