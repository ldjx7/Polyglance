<ui:FluentWindow x:Class="Polyglance.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Polyglance.UI.Controls"
        mc:Ignorable="d"
        Title="偏好设置 - Polyglance"
        Width="600" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="偏好设置" Icon="pack://application:,,,/Polyglance.UI;component/Resources/Polyglance.ico" Height="36"/>

        <TabControl Grid.Row="1" Margin="20,4,20,8" Background="Transparent" BorderThickness="0">
            <!-- 1. 通用 -->
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,12">
                        <ui:Card Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="开机时自动启动 Polyglance" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="登录 Windows 后在后台启动，并驻留系统托盘" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ChkLaunchAtLogin" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. 翻译服务 -->
            <TabItem Header="服务配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,12">
                        <ui:Card Margin="0,0,0,10" Padding="14">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="默认翻译引擎" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="选择截屏与文本翻译的默认服务商" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbProvider" Width="180" Height="32" VerticalContentAlignment="Center" DockPanel.Dock="Right">
                                    <ComboBoxItem Content="Microsoft (免费内置)" Tag="microsoft"/>
                                    <ComboBoxItem Content="Google (免费内置)" Tag="google"/>
                                    <ComboBoxItem Content="FreeAI (免费内置)" Tag="freeai"/>
                                    <ComboBoxItem Content="OpenAI Compatible" Tag="openaicompatible"/>
                                </ComboBox>
                            </DockPanel>
                        </ui:Card>

                        <ui:CardExpander Header="自定义大模型 (OpenAI 兼容协议)" IsExpanded="True">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="API Endpoint" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtEndpoint" PlaceholderText="https://api.openai.com/v1" Margin="0,0,0,8"/>

                                <TextBlock Text="API Key" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:PasswordBox x:Name="TxtApiKey" PlaceholderText="sk-..." Margin="0,0,0,8"/>

                                <TextBlock Text="Model 名称" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtModel" PlaceholderText="gpt-4o-mini" Margin="0,0,0,10"/>

                                <ui:ToggleSwitch x:Name="ChkAiStreaming" Content="启用 AI 流式实时输出" IsChecked="True"/>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. 自定义快捷键录制 -->
            <TabItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,12">
                        <ui:Card Margin="0,0,0,8" Padding="14">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="截图并贴图 (Screenshot &amp; Pin)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="触发屏幕框选，支持标注与固定置顶" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <controls:ShortcutRecorderControl x:Name="RecHotkeyScreenshotPin" DockPanel.Dock="Right" MinWidth="110"/>
                            </DockPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8" Padding="14">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="智能屏幕原位翻译 (In-Place Screen Translation)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="框选屏幕并在原图坐标上覆盖呈现译文" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <controls:ShortcutRecorderControl x:Name="RecHotkeyScreenTranslate" DockPanel.Dock="Right" MinWidth="110"/>
                            </DockPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8" Padding="14">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="打开主翻译面板 (Main Translator)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="打开双栏翻译控制台（自动填入剪贴板文本）" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <controls:ShortcutRecorderControl x:Name="RecHotkeyMainTranslator" DockPanel.Dock="Right" MinWidth="110"/>
                            </DockPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8" Padding="14">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="全局划词/选中文本即时翻译 (Quick Selection)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="抓取任意应用当前选中文本并即时弹出翻译" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <controls:ShortcutRecorderControl x:Name="RecHotkeySelectedText" DockPanel.Dock="Right" MinWidth="110"/>
                            </DockPanel>
                        </ui:Card>

                        <ui:Card Padding="14">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="滚动长截图会话 (Scrolling Stitcher)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="触发 Rust 驱动的超长网页与文档滚动截图拼接" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <controls:ShortcutRecorderControl x:Name="RecHotkeyLongScreenshot" DockPanel.Dock="Right" MinWidth="110"/>
                            </DockPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. 更新与关于 -->
            <TabItem Header="更新与关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,12">
                        <!-- 自动更新配置 -->
                        <ui:Card Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="检查版本更新" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtCurrentVersion" Text="当前版本: v0.0.3" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:Button x:Name="BtnCheckUpdate" Appearance="Secondary" Content="立即检查更新" DockPanel.Dock="Right" Click="OnCheckUpdateClick"/>
                                </DockPanel>

                                <ui:ToggleSwitch x:Name="ChkAutoCheckUpdates" Content="启动应用时自动在后台静默检查更新" IsChecked="True"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- 关于 -->
                        <ui:Card Padding="24">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="14" Background="#0A84FF" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <TextBlock Text="P" FontWeight="Black" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Polyglance" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="v0.0.3 (Fluent Edition)" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                <TextBlock Text="多语言内容，一眼看懂" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <TextBlock Text="基于 Rust 共享内核的原生跨平台翻译与截图工具" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部保存按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <ui:Button Appearance="Secondary" Content="取消" Margin="0,0,8,0" Padding="16,6" Click="OnCancelClick"/>
            <ui:Button Appearance="Primary" Content="保存配置" Padding="20,6" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
