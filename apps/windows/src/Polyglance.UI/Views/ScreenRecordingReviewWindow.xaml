<Window x:Class="Polyglance.UI.Views.ScreenRecordingReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="录屏预览"
        Width="760"
        Height="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FFFFFF"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="8" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Background="#F8FAFC" MouseDown="OnTitleBarMouseDown">
                <TextBlock x:Name="TxtTitle"
                           Text="录屏预览"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#1E293B"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>

                <ui:Button Appearance="Transparent"
                           HorizontalAlignment="Right"
                           Width="36"
                           Height="40"
                           Padding="0"
                           Click="OnCloseClick">
                    <Path Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                          Fill="#64748B"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"/>
                </ui:Button>
            </Grid>

            <!-- 中间播放预览区与进度条 -->
            <Grid Grid.Row="1" Margin="16,12,16,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <MediaElement x:Name="PlayerMedia"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Close"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      MediaOpened="OnMediaOpened"
                                      MediaEnded="OnMediaEnded"/>
                        <Image x:Name="PlayerImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- 播放进度条与时间显示 -->
                <Grid Grid.Row="1" Margin="4,8,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="ProgressSlider"
                            Grid.Column="0"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            IsSnapToTickEnabled="False"
                            UseLayoutRounding="False"
                            SnapsToDevicePixels="False"
                            Focusable="False"
                            VerticalAlignment="Center"
                            ValueChanged="OnProgressSliderValueChanged"
                            PreviewMouseDown="OnProgressSliderMouseDown"
                            PreviewMouseUp="OnProgressSliderMouseUp"/>

                    <TextBlock x:Name="TxtTimeProgress"
                               Grid.Column="1"
                               Text="00:00 / 00:00"
                               FontSize="11.5"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               Margin="10,0,2,0"
                               FontFamily="Segoe UI, Consolas"/>
                </Grid>
            </Grid>

            <!-- 底部操作按钮栏 (对齐 macOS ScreenRecordingReviewSession) -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <!-- 播放 / 暂停 -->
                <ui:Button x:Name="BtnPlayPause"
                           Appearance="Secondary"
                           Content="暂停"
                           Height="34"
                           Padding="16,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           CornerRadius="8"
                           Click="OnPlayPauseClick"/>

                <!-- 保存另存为 -->
                <ui:Button Appearance="Primary"
                           Content="保存为"
                           Height="34"
                           Padding="18,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           CornerRadius="8"
                           Click="OnSaveClick"/>

                <!-- 快速保存 -->
                <ui:Button Appearance="Secondary"
                           Content="快速保存"
                           Height="34"
                           Padding="14,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           CornerRadius="8"
                           Click="OnQuickSaveClick"/>

                <!-- 复制并关闭 -->
                <ui:Button Appearance="Secondary"
                           Content="复制并关闭"
                           Height="34"
                           Padding="14,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           CornerRadius="8"
                           Click="OnCopyFileClick"/>

                <!-- 重新录制 -->
                <ui:Button Appearance="Secondary"
                           Content="重新录制"
                           Height="34"
                           Padding="14,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           CornerRadius="8"
                           Click="OnRestartClick"/>

                <!-- 丢弃 -->
                <ui:Button Appearance="Transparent"
                           Content="丢弃"
                           Height="34"
                           Padding="14,0"
                           FontSize="12.5"
                           CornerRadius="8"
                           Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
