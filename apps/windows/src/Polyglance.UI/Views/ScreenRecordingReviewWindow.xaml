<Window x:Class="Polyglance.UI.Views.ScreenRecordingReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="录屏预览"
        Width="760"
        Height="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Background="#F8FAFC" MouseDown="OnTitleBarMouseDown">
                <TextBlock x:Name="TxtTitle"
                           Text="录屏预览"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#1E293B"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>

                <ui:Button Appearance="Transparent"
                           HorizontalAlignment="Right"
                           Width="36"
                           Height="40"
                           Padding="0"
                           Click="OnCloseClick">
                    <Path Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                          Fill="#64748B"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"/>
                </ui:Button>
            </Grid>

            <!-- 中间播放预览区 -->
            <Border Grid.Row="1" Background="#0F172A" Margin="16,12,16,8" CornerRadius="8" ClipToBounds="True">
                <Image x:Name="PlayerImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <!-- 底部操作按钮栏 (对齐 macOS ScreenRecordingReviewSession) -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <!-- 播放 / 暂停 -->
                <ui:Button x:Name="BtnPlayPause"
                           Appearance="Secondary"
                           Content="暂停"
                           Height="34"
                           Padding="16,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           CornerRadius="8"
                           Click="OnPlayPauseClick"/>

                <!-- 保存另存为 -->
                <ui:Button Appearance="Primary"
                           Content="保存为"
                           Height="34"
                           Padding="18,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           CornerRadius="8"
                           Click="OnSaveClick"/>

                <!-- 快速保存 -->
                <ui:Button Appearance="Secondary"
                           Content="快速保存"
                           Height="34"
                           Padding="14,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           CornerRadius="8"
                           Click="OnQuickSaveClick"/>

                <!-- 复制文件 -->
                <ui:Button Appearance="Secondary"
                           Content="复制文件"
                           Height="34"
                           Padding="14,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           CornerRadius="8"
                           Click="OnCopyFileClick"/>

                <!-- 重新录制 -->
                <ui:Button Appearance="Secondary"
                           Content="重新录制"
                           Height="34"
                           Padding="14,0"
                           Margin="0,0,8,0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           CornerRadius="8"
                           Click="OnRestartClick"/>

                <!-- 关闭 -->
                <ui:Button Appearance="Transparent"
                           Content="关闭"
                           Height="34"
                           Padding="12,0"
                           FontSize="12.5"
                           CornerRadius="8"
                           Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
