<Window x:Class="Polyglance.UI.Views.PinHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="贴图历史"
        Width="680" Height="480"
        MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        KeyDown="OnKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#100A84FF" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0">
                    <TextBlock Text="贴" FontWeight="Bold" FontSize="12" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="贴图历史" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCount" Text="(0)" FontSize="12" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="仅保存在本机（最多 30 条 / 512 MiB）。可在设置中开启截图自动记录。"
                       FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 主内容区域：网格缩略图 -->
        <Grid Grid.Row="1">
            <!-- 空状态 -->
            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Background="#E2E8F0" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="图" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="暂无贴图历史" FontSize="14" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="截图、剪贴板、文字识别与截屏翻译贴图会自动保存在这里" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 历史列表 -->
            <ListBox x:Name="LstHistory"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnItemDoubleClicked">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="CardBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8"
                                            Width="190">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
                                        </Border.Effect>
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0A84FF"/>
                                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="CardBorder" Property="Background" Value="#F0F7FF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#93C5FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- 缩略图容器 -->
                            <Border Background="#F1F5F9" CornerRadius="4" Height="110" Margin="0,0,0,6" ClipToBounds="True">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 信息行 -->
                            <DockPanel Margin="0,2,0,2">
                                <Border Background="#100A84FF" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceName}" FontSize="10" FontWeight="Medium" Foreground="#0A84FF"/>
                                </Border>
                                <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding DateString}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 底部操作栏 -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="BtnClearAll" Content="清空全部…" Padding="12,6" Background="#FFFFFF" BorderBrush="#E2E8F0" Foreground="#EF4444" Click="OnClearAllClick"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnDelete" Content="删除" Padding="14,6" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#CBD5E1" Click="OnDeleteClick"/>
                <Button x:Name="BtnPin" Content="贴出" Padding="18,6" Background="#0A84FF" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="OnPinClick">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#0A84FF"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
