<Window x:Class="Polyglance.UI.Views.OcrSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 文字选择 - Polyglance"
        Width="920"
        Height="680"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="18,14,18,10">
            <StackPanel>
                <TextBlock Text="OCR 文字选择" FontSize="17" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock x:Name="TxtStatus"
                           Text="拖动框选要复制或翻译的文字；未选择时操作全部文字"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#657087"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="16,0"
                Background="White"
                BorderBrush="#D9DEE8"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="Both">
                <Grid x:Name="ImageSurface"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="White"
                      MouseLeftButtonDown="OnSurfaceMouseDown"
                      MouseMove="OnSurfaceMouseMove"
                      MouseLeftButtonUp="OnSurfaceMouseUp">
                    <Image x:Name="OriginalImage" Stretch="None"/>
                    <Canvas x:Name="WordCanvas" IsHitTestVisible="False"/>
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="SelectionBorder"
                                Visibility="Collapsed"
                                Background="#260A84FF"
                                BorderBrush="#0A84FF"
                                BorderThickness="1.5"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="16,12,16,16">
            <Button Content="关闭"
                    Width="76"
                    Height="32"
                    Click="OnCloseClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制全部"
                        MinWidth="86"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="OnCopyAllClick"/>
                <Button Content="复制所选"
                        MinWidth="86"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="OnCopySelectionClick"/>
                <Button x:Name="BtnTranslate"
                        Content="翻译所选"
                        MinWidth="92"
                        Height="32"
                        Background="#0A84FF"
                        Foreground="White"
                        BorderThickness="0"
                        Click="OnTranslateClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
