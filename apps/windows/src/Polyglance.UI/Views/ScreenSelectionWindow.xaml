<Window x:Class="Polyglance.UI.Views.ScreenSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Polyglance.UI.Controls"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        KeyDown="OnKeyDown"
        MouseDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseUp="OnMouseUp"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed">
    <Grid x:Name="RootGrid">
        <!-- 截取的底层屏幕画面 -->
        <Image x:Name="BackgroundImage" Stretch="Fill"/>

        <!-- 4块高性能硬件加速半透明暗化遮罩 -->
        <Canvas x:Name="MaskCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="MaskTop" Fill="#66000000"/>
            <Rectangle x:Name="MaskBottom" Fill="#66000000"/>
            <Rectangle x:Name="MaskLeft" Fill="#66000000"/>
            <Rectangle x:Name="MaskRight" Fill="#66000000"/>
        </Canvas>

        <!-- 标注图层 -->
        <Canvas x:Name="AnnotationCanvas" ClipToBounds="True"/>

        <!-- 选区边框与调节手柄 -->
        <Canvas x:Name="SelectionCanvas" ClipToBounds="False">
            <!-- 智能窗口吸附候选边框 -->
            <Border x:Name="CandidateBorder"
                    BorderBrush="#0A84FF"
                    BorderThickness="2"
                    CornerRadius="4"
                    Background="#150A84FF"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>

            <!-- 选区主边框 -->
            <Border x:Name="SelectionBorder"
                    BorderBrush="#0A84FF"
                    BorderThickness="1.8"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                </Border.Effect>
            </Border>

            <!-- 8个调节手柄 (四角与四边中点) -->
            <Canvas x:Name="HandlesCanvas" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="HandleTL" Width="8" Height="8" Background="White" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="1.5"/>
                <Border x:Name="HandleT"  Width="8" Height="8" Background="White" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="1.5"/>
                <Border x:Name="HandleTR" Width="8" Height="8" Background="White" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="1.5"/>
                <Border x:Name="HandleR"  Width="8" Height="8" Background="White" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="1.5"/>
                <Border x:Name="HandleBR" Width="8" Height="8" Background="White" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="1.5"/>
                <Border x:Name="HandleB"  Width="8" Height="8" Background="White" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="1.5"/>
                <Border x:Name="HandleBL" Width="8" Height="8" Background="White" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="1.5"/>
                <Border x:Name="HandleL"  Width="8" Height="8" Background="White" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="1.5"/>
            </Canvas>

            <!-- 尺寸指示药丸 -->
            <Border x:Name="SizeBadge"
                    Background="#D91E1E24"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,3"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDimension" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI, Consolas"/>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 浮动控件层 (放大镜与工具栏) -->
        <Canvas x:Name="OverlayCanvas">
            <!-- 放大镜 -->
            <controls:MagnifierControl x:Name="Magnifier" Visibility="Collapsed"/>

            <!-- PixPin 纯白圆角工具栏 -->
            <controls:ScreenshotToolbar x:Name="Toolbar" Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>
