<Window x:Class="Polyglance.UI.Views.OcrWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        MinWidth="520"
        MinHeight="400"
        Width="680"
        Height="520"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C4101E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Margin="10"
            Background="#FFFFFF"
            BorderBrush="#24000000"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="18" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Toolbar -->
                <RowDefinition Height="Auto"/> <!-- Image Preview (Collapsible) -->
                <RowDefinition Height="*"/> <!-- Text Editor -->
                <RowDefinition Height="42"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="#F8F9FA"
                    CornerRadius="8,8,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Path Data="M19,3 H5 C3.9,3 3,3.9 3,5 V19 C3,20.1 3.9,21 5,21 H19 C20.1,21 21,20.1 21,19 V5 C21,3.9 20.1,3 19,3 Z M7,7 H17 V9 H7 V7 Z M7,11 H17 V13 H7 V11 Z M7,15 H14 V17 H7 V15 Z"
                              Width="14" Height="14"
                              Fill="#0A84FF"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Polyglance 文字识别" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnPin"
                                Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="置顶窗口"
                                Foreground="#6B7280"
                                Margin="0,0,4,0"
                                Click="OnPinClick">
                            <Path Data="M16,12 V4 H17 V2 H7 V4 H8 V12 L6,14 V16 H11 V22 L12,23 L13,22 V16 H18 V14 L16,12 Z"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButtonStyle}"
                                ToolTip="关闭 (Esc)"
                                Foreground="#6B7280"
                                Click="OnCloseClick">
                            <Path Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                                  Width="10" Height="10"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Toolbar -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="12,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Copy All Button -->
                    <Button x:Name="BtnCopyAll"
                            Content="复制全部"
                            MinWidth="76" Height="28"
                            Margin="0,0,8,0"
                            Background="#0A84FF"
                            Foreground="#FFFFFF"
                            FontWeight="Medium"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="复制全部识别文本 (Enter)"
                            Click="OnCopyAllClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Formatting Menu Button -->
                    <Button x:Name="BtnFormatting"
                            Content="排版设置 ▾"
                            Height="28" Padding="10,0"
                            Margin="0,0,8,0"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderThickness="1"
                            BorderBrush="#E5E7EB"
                            Cursor="Hand"
                            Click="OnFormattingMenuClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="FormattingMenu">
                                <MenuItem x:Name="MenuSmartMerge" Header="智能合并折行" IsCheckable="True" Click="OnSelectSmartMerge"/>
                                <MenuItem x:Name="MenuPreserveBreaks" Header="保持原样换行" IsCheckable="True" Click="OnSelectPreserveBreaks"/>
                                <MenuItem x:Name="MenuRemoveSpaces" Header="清除多余空格" IsCheckable="True" Click="OnSelectRemoveSpaces"/>
                                <MenuItem x:Name="MenuRaw" Header="原始文本" IsCheckable="True" Click="OnSelectRaw"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Continuous Recognition Toggle -->
                    <ToggleButton x:Name="BtnContinuous"
                                  Content="连续识别"
                                  Height="28" Padding="10,0"
                                  Margin="0,0,8,0"
                                  Cursor="Hand"
                                  ToolTip="开启后截图识别将自动追加在文末"
                                  Click="OnContinuousClick"/>

                    <!-- Show Original Image CheckBox -->
                    <CheckBox x:Name="ChkShowImage"
                              Content="显示原始图片"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="8,0,8,0"
                              Cursor="Hand"
                              Click="OnShowImageChanged"/>
                </StackPanel>
            </Border>

            <!-- Collapsible Image Preview Section (Bounded interactive viewport) -->
            <Border x:Name="ImagePreviewSection"
                    Grid.Row="2"
                    Background="#F5F5F7"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,1"
                    Height="180"
                    Visibility="Visible"
                    ClipToBounds="True"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    PreviewMouseLeftButtonDown="OnViewportMouseDown"
                    PreviewMouseMove="OnViewportMouseMove"
                    PreviewMouseLeftButtonUp="OnViewportMouseUp"
                    PreviewMouseWheel="OnViewportMouseWheel"
                    SizeChanged="OnImagePreviewSizeChanged">
                <Grid x:Name="ViewportGrid" ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Canvas x:Name="ImageCanvas" ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Image x:Name="ImgViewport"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderOptions.EdgeMode="Aliased"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               Stretch="None">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ViewportScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="ViewportTranslateTransform" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>

                    <!-- Multi-image paging overlay -->
                    <Border x:Name="PagingOverlay"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,12,10"
                            Background="#99000000"
                            CornerRadius="12"
                            Padding="8,3"
                            Panel.ZIndex="100"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnPrevPage" Content="◀" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="OnPrevImageClick" Width="20" Height="20" Padding="0"/>
                            <TextBlock x:Name="TxtImagePage" Text="1 / 1" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="6,0"/>
                            <Button x:Name="BtnNextPage" Content="▶" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="OnNextImageClick" Width="20" Height="20" Padding="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Text Content Editor -->
            <Border Grid.Row="3" Background="#FFFFFF" Padding="4">
                <Grid>
                    <TextBox x:Name="TxtContent"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontSize="14"
                             FontFamily="Segoe UI, Microsoft YaHei UI, Consolas"
                             Foreground="#111827"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10"
                             TextChanged="OnContentTextChanged"/>

                    <!-- Loading Indicator Overlay -->
                    <Border x:Name="LoadingOverlay"
                            Background="#F0FFFFFF"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True"
                                         Width="120"
                                         Height="4"
                                         BorderThickness="0"
                                         Foreground="#0A84FF"
                                         Margin="0,0,0,10"/>
                            <TextBlock Text="正在识别中..."
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="4"
                    Background="#F9FAFB"
                    CornerRadius="0,0,8,8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Auto Copy Option -->
                    <CheckBox x:Name="ChkAutoCopyNextTime"
                              Grid.Column="0"
                              Content="下次直接复制文本"
                              VerticalAlignment="Center"
                              Cursor="Hand"
                              ToolTip="勾选后下次截图识别将直接写入剪贴板，不弹窗"
                              Click="OnAutoCopyNextTimeChanged"/>

                    <!-- Language and Info -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStats" Text="字符数: 0" FontSize="12" Foreground="#6B7280" Margin="0,0,16,0"/>
                        <TextBlock x:Name="TxtLanguage" Text="识别语言: 简体中文" FontSize="12" Foreground="#6B7280"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

