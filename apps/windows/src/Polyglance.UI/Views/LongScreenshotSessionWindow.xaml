<Window x:Class="Polyglance.UI.Views.LongScreenshotSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        KeyDown="OnKeyDown"
        MouseDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseUp="OnMouseUp"
        MouseWheel="OnMouseWheel">
    <Grid x:Name="RootGrid">
        <!-- 底图 -->
        <Image x:Name="BackgroundImage" Stretch="Fill"/>

        <!-- 4块半透明暗化遮罩 -->
        <Canvas x:Name="MaskCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="MaskTop" Fill="#77000000"/>
            <Rectangle x:Name="MaskBottom" Fill="#77000000"/>
            <Rectangle x:Name="MaskLeft" Fill="#77000000"/>
            <Rectangle x:Name="MaskRight" Fill="#77000000"/>
        </Canvas>

        <!-- 选区边框与指示 -->
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <Border x:Name="SelectionBorder"
                    BorderBrush="#0A84FF"
                    BorderThickness="2"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                </Border.Effect>
            </Border>

            <!-- 拼接高度状态胶囊 -->
            <Border x:Name="StatusBadge"
                    Background="#E61E1E24"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10,4"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="请滚动鼠标滚轮开始拼接…" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 悬浮控制工具栏 -->
        <Canvas x:Name="OverlayCanvas">
            <Border x:Name="ControlToolbar"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="8,4"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.1" Color="#000000"/>
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 自动向下滚动开关 -->
                    <ui:Button x:Name="BtnAutoScroll"
                               Appearance="Transparent"
                               Icon="{ui:SymbolIcon Play24}"
                               Content="自动滚动"
                               Height="30"
                               FontSize="12"
                               Padding="8,0"
                               Margin="0,0,4,0"
                               Click="OnToggleAutoScrollClick"/>

                    <Rectangle Width="1" Height="16" Fill="#E5E7EB" Margin="2,0,6,0" VerticalAlignment="Center"/>

                    <!-- 完成拼接 -->
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon Checkmark24}"
                               Content="完成拼接"
                               Height="30"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Padding="14,0"
                               Margin="0,0,4,0"
                               Click="OnFinishClick"/>

                    <!-- 取消 -->
                    <ui:Button Appearance="Transparent"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Content="取消"
                               Height="30"
                               FontSize="12"
                               Padding="8,0"
                               Click="OnCancelClick"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
