<Window x:Class="Polyglance.UI.Views.ScreenRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <Style x:Key="RecordingComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Canvas x:Name="OverlayCanvas">
            <!-- 录屏选区红框 -->
            <Border x:Name="RecordingBorder"
                    BorderBrush="#EF4444"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" Color="#EF4444"/>
                </Border.Effect>
            </Border>

            <!-- 浮动在选区下方的录屏控制工具栏 (与 macOS 100% 对齐) -->
            <Border x:Name="ControlToolbar"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6"
                    Width="710"
                    Height="46"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 生成中转圈指示器 -->
                    <ui:ProgressRing x:Name="RingSaving"
                                     IsIndeterminate="True"
                                     Width="16"
                                     Height="16"
                                     Margin="0,0,6,0"
                                     Visibility="Collapsed"/>

                    <!-- 状态标签 -->
                    <TextBlock x:Name="TxtStatus"
                               Text="待录制"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#1E293B"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI, Consolas"
                               Margin="0,0,10,0"
                               MinWidth="54"/>

                    <!-- 格式下拉 -->
                    <ComboBox x:Name="CmbFormat"
                              Style="{StaticResource RecordingComboBoxStyle}"
                              SelectedIndex="0"
                              SelectionChanged="OnFormatChanged"
                              Width="80"
                              Margin="0,0,6,0">
                        <ComboBoxItem Content="MP4"/>
                        <ComboBoxItem Content="GIF"/>
                    </ComboBox>

                    <!-- 质量下拉 -->
                    <ComboBox x:Name="CmbQuality"
                              Style="{StaticResource RecordingComboBoxStyle}"
                              SelectedIndex="0"
                              Width="88"
                              Margin="0,0,6,0">
                        <ComboBoxItem Content="标准"/>
                        <ComboBoxItem Content="高清"/>
                        <ComboBoxItem Content="原画"/>
                    </ComboBox>

                    <!-- 帧率下拉 -->
                    <ComboBox x:Name="CmbFps"
                              Style="{StaticResource RecordingComboBoxStyle}"
                              SelectedIndex="1"
                              Width="96"
                              Margin="0,0,6,0">
                        <ComboBoxItem Content="60 FPS"/>
                        <ComboBoxItem Content="30 FPS"/>
                        <ComboBoxItem Content="15 FPS"/>
                    </ComboBox>

                    <!-- 延时下拉 -->
                    <ComboBox x:Name="CmbDelay"
                              Style="{StaticResource RecordingComboBoxStyle}"
                              SelectedIndex="0"
                              Width="102"
                              Margin="0,0,8,0">
                        <ComboBoxItem Content="无延时"/>
                        <ComboBoxItem Content="3秒"/>
                        <ComboBoxItem Content="5秒"/>
                        <ComboBoxItem Content="10秒"/>
                    </ComboBox>

                    <!-- 声音开关 -->
                    <ui:Button x:Name="BtnAudio" Appearance="Transparent" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="录制系统声音" Click="OnToggleAudio">
                        <Grid Width="16" Height="16">
                            <Path x:Name="IconAudio" Data="M3,9 H7 L12,4 V20 L7,15 H3 Z M16.5,12 C16.5,10.23 15.5,8.71 14,7.97 V16.02 C15.5,15.29 16.5,13.77 16.5,12 Z" Fill="#0A84FF" Width="14" Height="14" Stretch="Uniform"/>
                            <Path x:Name="IconAudioSlash" Data="M4,4 L20,20" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Grid>
                    </ui:Button>

                    <!-- 麦克风开关 -->
                    <ui:Button x:Name="BtnMic" Appearance="Transparent" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="录制麦克风" Click="OnToggleMic">
                        <Grid Width="16" Height="16">
                            <Path x:Name="IconMic" Data="M12,14 C13.66,14 15,12.66 15,11 V5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 V11 C9,12.66 10.34,14 12,14 Z M19,11 C19,14.53 16.39,17.44 13,17.93 V21 H11 V17.93 C7.61,17.44 5,14.53 5,11 H7 C7,13.76 9.24,16 12,16 C14.76,16 17,13.76 17,11 H19 Z" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform"/>
                            <Path x:Name="IconMicSlash" Data="M4,4 L20,20" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Visible"/>
                        </Grid>
                    </ui:Button>

                    <!-- 鼠标光标开关 -->
                    <ui:Button x:Name="BtnCursor" Appearance="Transparent" Width="28" Height="28" Padding="0" Margin="0,0,6,0" ToolTip="显示鼠标指针" Click="OnToggleCursor">
                        <Path x:Name="IconCursor" Data="M3,3 L10.5,21 L13.5,13.5 L21,10.5 Z" Fill="#0A84FF" Width="13" Height="13" Stretch="Uniform"/>
                    </ui:Button>

                    <!-- 开始录制 -->
                    <ui:Button x:Name="BtnStart" Appearance="Transparent" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="开始录制" Click="OnStartClick">
                        <Grid Width="16" Height="16">
                            <Ellipse Width="16" Height="16" Stroke="#EF4444" StrokeThickness="1.6"/>
                            <Ellipse Width="8" Height="8" Fill="#EF4444"/>
                        </Grid>
                    </ui:Button>

                    <!-- 暂停录制 -->
                    <ui:Button x:Name="BtnPause" Appearance="Transparent" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="暂停录制" IsEnabled="False" Opacity="0.35" Click="OnPauseClick">
                        <Path x:Name="IconPause" Data="M6,19 H10 V5 H6 Z M14,5 V19 H18 V5 Z" Fill="#1E293B" Width="12" Height="12" Stretch="Uniform"/>
                    </ui:Button>

                    <!-- 停止并预览 -->
                    <ui:Button x:Name="BtnStop" Appearance="Transparent" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="停止并预览" IsEnabled="False" Opacity="0.35" Click="OnStopClick">
                        <Rectangle Width="12" Height="12" Fill="#1E293B" RadiusX="2" RadiusY="2"/>
                    </ui:Button>

                    <!-- 关闭取消 -->
                    <ui:Button x:Name="BtnClose" Appearance="Transparent" Width="28" Height="28" Padding="0" ToolTip="关闭录屏" Click="OnCancelClick">
                        <Path Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z" Fill="#64748B" Width="12" Height="12" Stretch="Uniform"/>
                    </ui:Button>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
