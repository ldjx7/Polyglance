<ui:FluentWindow x:Class="Polyglance.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Polyglance"
        Width="460" Height="540"
        MinWidth="380" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        ToolTipService.InitialShowDelay="150"
        ToolTipService.BetweenShowDelay="50"
        ToolTipService.ShowDuration="10000"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Microsoft YaHei UI">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Win11 标题栏 -->
            <RowDefinition Height="32"/>
            <!-- 1: 顶部快捷工具栏 (对齐 Bob 8大按钮) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 原文卡片 -->
            <RowDefinition Height="Auto"/>
            <!-- 3: 中置语言与服务商栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 4: 多引擎译文卡片列表 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0. 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="Polyglance"
                     Height="32">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Polyglance;component/Resources/Polyglance.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 1. 顶部操作栏 (对齐 Bob 8大按钮) -->
        <Grid Grid.Row="1" Margin="14,0,14,8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧 7 大快捷操作 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 1. 钉住/取消钉住 -->
                <ui:Button x:Name="BtnPin"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Pin24}"
                           Width="28" Height="28"
                           Padding="0"
                           CornerRadius="14"
                           ToolTip="置顶窗口"
                           Click="OnTogglePinClick"/>

                <!-- 2. 收藏当前翻译 (Ctrl+S) -->
                <ui:Button x:Name="BtnFavorite"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Star24}"
                           Width="28" Height="28"
                           Padding="0"
                           CornerRadius="14"
                           Margin="4,0,0,0"
                           ToolTip="收藏当前翻译 (Ctrl+S)"
                           Click="OnToggleFavoriteClick"/>

                <!-- 3. 历史记录与收藏夹 -->
                <ui:Button x:Name="BtnHistory"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon History24}"
                           Width="28" Height="28"
                           Padding="0"
                           CornerRadius="14"
                           Margin="4,0,0,0"
                           ToolTip="历史记录与收藏夹"
                           Click="OnOpenHistoryClick"/>

                <!-- 4. 截图/OCR划选翻译 -->
                <ui:Button x:Name="BtnScreenshot"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Crop24}"
                           Width="28" Height="28"
                           Padding="0"
                           CornerRadius="14"
                           Margin="4,0,0,0"
                           ToolTip="截图翻译"
                           Click="OnScreenshotTranslateClick"/>

                <!-- 5. 剪贴板翻译 -->
                <ui:Button x:Name="BtnClipboard"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ClipboardPaste24}"
                           Width="28" Height="28"
                           Padding="0"
                           CornerRadius="14"
                           Margin="4,0,0,0"
                           ToolTip="翻译剪贴板内容"
                           Click="OnClipboardTranslateClick"/>

                <!-- 6. 隐藏/显示输入框 -->
                <ui:Button x:Name="BtnFoldInput"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Eye24}"
                           Width="28" Height="28"
                           Padding="0"
                           CornerRadius="14"
                           Margin="4,0,0,0"
                           ToolTip="隐藏/显示输入框"
                           Click="OnToggleFoldInputClick"/>

                <!-- 7. 调整服务 -->
                <ui:Button x:Name="BtnServices"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon AppsListDetail24}"
                           Width="28" Height="28"
                           Padding="0"
                           CornerRadius="14"
                           Margin="4,0,0,0"
                           ToolTip="选择启用的翻译服务"
                           Click="OnAdjustServicesClick"/>
            </StackPanel>

            <!-- 右侧 8. 偏好设置 -->
            <ui:Button Grid.Column="2"
                       x:Name="BtnSettings"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon Settings24}"
                       Width="28" Height="28"
                       Padding="0"
                       CornerRadius="14"
                       ToolTip="偏好设置"
                       Click="OnOpenSettingsClick"/>
        </Grid>

        <!-- 2. 原文卡片 (Source Card) -->
        <Border Grid.Row="2"
                x:Name="BrdSourceCard"
                Margin="14,0,14,8"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.03" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 原文输入框 -->
                <Grid Grid.Row="0" MinHeight="65" MaxHeight="130">
                    <TextBox x:Name="TxtSource"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="13.5"
                             Foreground="#1F2937"
                             Padding="0"
                             Margin="0"
                             FocusVisualStyle="{x:Null}"
                             TextChanged="OnSourceTextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <TextBlock Text="输入或在此粘贴需要翻译的内容…"
                               Foreground="#9CA3AF"
                               FontSize="13.5"
                               IsHitTestVisible="False"
                               Margin="0,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSource}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 原文卡片底部工具栏 (朗读、复制、语种识别Badge、清空) -->
                <Grid Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 朗读原文 -->
                        <ui:Button x:Name="BtnSpeakSource"
                                   Appearance="Transparent"
                                   Icon="{ui:SymbolIcon Speaker224}"
                                   Width="24" Height="24"
                                   Padding="0"
                                   BorderThickness="0"
                                   CornerRadius="12"
                                   ToolTip="朗读原文"
                                   Opacity="0.4"
                                   IsEnabled="False"
                                   Click="OnSpeakSourceClick"/>

                        <!-- 复制原文 -->
                        <ui:Button x:Name="BtnCopySource"
                                   Appearance="Transparent"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Width="24" Height="24"
                                   Padding="0"
                                   BorderThickness="0"
                                   CornerRadius="12"
                                   ToolTip="复制原文"
                                   Margin="2,0,6,0"
                                   Opacity="0.4"
                                   IsEnabled="False"
                                   Click="OnCopySourceClick"/>

                        <!-- 语种识别 Badge (对齐 Bob: 支持点击切换源语言) -->
                        <Border x:Name="BrdDetectedLang"
                                CornerRadius="10"
                                Background="#EFF6FF"
                                Padding="6,2"
                                Visibility="Collapsed"
                                Cursor="Hand"
                                ToolTip="点击直接切换源语言"
                                MouseLeftButtonUp="OnDetectedLangClick"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="识别为 " FontSize="10.5" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtDetectedLang" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                <TextBlock Text=" ▾" FontSize="10.5" Foreground="#2563EB" Margin="1,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 右侧清空按钮 -->
                    <ui:Button Grid.Column="2"
                               x:Name="BtnClearSource"
                               Appearance="Transparent"
                               Icon="{ui:SymbolIcon DismissCircle24}"
                               Width="24" Height="24"
                               Padding="0"
                               BorderThickness="0"
                               CornerRadius="12"
                               ToolTip="清空内容"
                               Opacity="0.4"
                               IsEnabled="False"
                               Click="OnClearClick"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. 中置语言与服务商工具栏 (Language & Pinned Provider Toolbar) -->
        <Grid Grid.Row="3" Margin="14,0,14,8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 语言切换组 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="CmbSourceLang"
                          MinWidth="100"
                          Height="30"
                          FontSize="12"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          Padding="8,0,22,0"
                          SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="自动检测" Tag=""/>
                    <ComboBoxItem Content="英语 (EN)" Tag="en"/>
                    <ComboBoxItem Content="中文 (ZH)" Tag="zh-Hans"/>
                    <ComboBoxItem Content="日语 (JA)" Tag="ja"/>
                    <ComboBoxItem Content="韩语 (KO)" Tag="ko"/>
                    <ComboBoxItem Content="法语 (FR)" Tag="fr"/>
                    <ComboBoxItem Content="德语 (DE)" Tag="de"/>
                    <ComboBoxItem Content="西班牙语" Tag="es"/>
                    <ComboBoxItem Content="俄语 (RU)" Tag="ru"/>
                </ComboBox>

                <ui:Button Appearance="Transparent"
                           Content="⇄"
                           ToolTip="交换语言"
                           Margin="2,0"
                           Width="24" Height="24"
                           Padding="0"
                           CornerRadius="12"
                           Click="OnSwapLanguageClick"
                           FontWeight="Bold"
                           FontSize="12"/>

                <ComboBox x:Name="CmbTargetLang"
                          MinWidth="110"
                          Height="30"
                          FontSize="12"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          Padding="8,0,22,0"
                          SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="中文 (简体)" Tag="zh-Hans"/>
                    <ComboBoxItem Content="英语 (EN)" Tag="en"/>
                    <ComboBoxItem Content="日语 (JA)" Tag="ja"/>
                    <ComboBoxItem Content="韩语 (KO)" Tag="ko"/>
                    <ComboBoxItem Content="法语 (FR)" Tag="fr"/>
                    <ComboBoxItem Content="德语 (DE)" Tag="de"/>
                    <ComboBoxItem Content="西班牙语" Tag="es"/>
                    <ComboBoxItem Content="俄语 (RU)" Tag="ru"/>
                </ComboBox>
            </StackPanel>

            <!-- 钉住的服务图标条 (对齐 Bob 12) -->
            <StackPanel Grid.Column="1" x:Name="StkPinnedServices" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"/>

            <!-- 右侧：翻译服务商下拉 -->
            <ComboBox Grid.Column="2"
                      x:Name="CmbProvider"
                      MinWidth="110"
                      Height="30"
                      FontSize="12"
                      Padding="8,0,22,0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="OnProviderChanged">
                <ComboBoxItem Content="官方 AI" IsSelected="True" Tag="freeai"/>
                <ComboBoxItem Content="Microsoft" Tag="microsoft"/>
                <ComboBoxItem Content="Google" Tag="google"/>
                <ComboBoxItem Content="DeepL" Tag="deepl"/>
                <ComboBoxItem Content="百度翻译" Tag="baidu"/>
                <ComboBoxItem Content="有道翻译" Tag="youdao"/>
                <ComboBoxItem Content="火山翻译" Tag="volcano"/>
                <ComboBoxItem Content="OpenAI" Tag="openaicompatible"/>
            </ComboBox>
        </Grid>

        <!-- 4. 多引擎流式译文卡片列表 (Result Cards) -->
        <ScrollViewer Grid.Row="4" Margin="14,0,14,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="ItemsProviderCards">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Background="#FFFFFF"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.03" Color="#000000"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 头部：服务商名称、转圈加载、折叠摘要、设置菜单、折叠按钮 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding IconSource}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ui:ProgressRing IsIndeterminate="True"
                                                             Width="14" Height="14"
                                                             Margin="6,0,0,0"
                                                             Visibility="{Binding IsTranslatingVisibility}"
                                                             VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CollapsedPreviewText}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="240"
                                                       Visibility="{Binding CollapsedPreviewVisibility}"/>
                                        </StackPanel>

                                        <!-- 右侧：设置模式菜单与折叠按钮 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Transparent"
                                                       Icon="{ui:SymbolIcon Options24}"
                                                       Width="24" Height="24"
                                                       Padding="0"
                                                       BorderThickness="0"
                                                       CornerRadius="12"
                                                       ToolTip="设置服务显示与折叠模式"
                                                       Margin="0,0,2,0"
                                                       Tag="{Binding}"
                                                       Click="OnCardOptionsClick"/>

                                            <ui:Button Appearance="Transparent"
                                                       Content="{Binding CollapseIconText}"
                                                       Width="24" Height="24"
                                                       Padding="0"
                                                       BorderThickness="0"
                                                       CornerRadius="12"
                                                       ToolTip="{Binding CollapseToolTip}"
                                                       Tag="{Binding}"
                                                       Click="OnToggleCardCollapseClick"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 译文内容 (未折叠时显示) -->
                                    <Grid Grid.Row="1" Margin="0,4,0,6" Visibility="{Binding ContentVisibility}">
                                        <TextBox IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="13.5"
                                                 FontWeight="Medium"
                                                 Foreground="#111827"
                                                 Padding="0"
                                                 Margin="0"
                                                 Text="{Binding Text}"
                                                 FocusVisualStyle="{x:Null}">
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>

                                        <!-- 占位提示/错误 -->
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusTextColor}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding PlaceholderVisibility}"/>
                                    </Grid>

                                    <!-- 卡片底部操作栏 (朗读、复制、回填替换 ↪) -->
                                    <Grid Grid.Row="2" Visibility="{Binding ContentVisibility}" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 朗读 -->
                                            <ui:Button Appearance="Transparent"
                                                       Icon="{ui:SymbolIcon Speaker224}"
                                                       Width="24" Height="24"
                                                       Padding="0"
                                                       BorderThickness="0"
                                                       CornerRadius="12"
                                                       ToolTip="朗读译文"
                                                       Opacity="{Binding ActionOpacity}"
                                                       IsEnabled="{Binding HasText}"
                                                       Tag="{Binding}"
                                                       Click="OnSpeakCardClick"/>

                                            <!-- 复制 -->
                                            <ui:Button Appearance="Transparent"
                                                       Icon="{ui:SymbolIcon Copy24}"
                                                       Width="24" Height="24"
                                                       Padding="0"
                                                       BorderThickness="0"
                                                       CornerRadius="12"
                                                       ToolTip="复制译文"
                                                       Margin="2,0,0,0"
                                                       Opacity="{Binding ActionOpacity}"
                                                       IsEnabled="{Binding HasText}"
                                                       Tag="{Binding}"
                                                       Click="OnCopyCardClick"/>
                                        </StackPanel>

                                        <!-- 右侧：替换选中文本 (Bob 核心特性: 插入到原文位置替换原文) -->
                                        <ui:Button Grid.Column="2"
                                                   Appearance="Transparent"
                                                   Content="↪ 替换原文"
                                                   FontSize="11.5"
                                                   Padding="6,2"
                                                   CornerRadius="6"
                                                   ToolTip="将译文回填替换原应用中的选中文本"
                                                   Opacity="{Binding ActionOpacity}"
                                                   IsEnabled="{Binding HasText}"
                                                   Tag="{Binding}"
                                                   Click="OnReplaceCardClick"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 兼容性保留隐藏元素 -->
                <TextBox x:Name="TxtTarget" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtTargetPlaceholder" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtActiveProviderName" Visibility="Collapsed"/>
                <ui:ProgressRing x:Name="PrgTranslating" Visibility="Collapsed"/>
                <ui:Button x:Name="BtnSpeakTarget" Visibility="Collapsed"/>
                <ui:Button x:Name="BtnCopyTarget" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
