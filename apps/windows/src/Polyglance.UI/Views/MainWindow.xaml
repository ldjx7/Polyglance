<ui:FluentWindow x:Class="Polyglance.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Polyglance"
        Width="920" Height="560"
        MinWidth="740" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Microsoft YaHei UI">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Win11 标题栏 (含Logo与Title) -->
            <RowDefinition Height="Auto"/>
            <!-- 1: 顶部控制栏 (语言切换、服务商、置顶、设置) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 左右双栏卡片 -->
            <RowDefinition Height="*"/>
            <!-- 3: 底部悬浮控制栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. 标题栏：左侧带原生图标与Polyglance标题，与红绿灯/最小化按钮同行 -->
        <ui:TitleBar Grid.Row="0"
                     Title="Polyglance"
                     Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Polyglance;component/Resources/Polyglance.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 1. 顶部控制栏 (布局对称) -->
        <Grid Grid.Row="1" Margin="20,0,20,12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 中间：语言切换胶囊 -->
            <Border Grid.Column="1"
                    HorizontalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="6,2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.05" Color="#000000"/>
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CmbSourceLang"
                              MinWidth="115"
                              Height="32"
                              FontSize="12.5"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center"
                              Padding="10,0,24,0"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="自动检测" Tag=""/>
                        <ComboBoxItem Content="英语 (EN)" Tag="en"/>
                        <ComboBoxItem Content="中文 (ZH)" Tag="zh-Hans"/>
                        <ComboBoxItem Content="日语 (JA)" Tag="ja"/>
                        <ComboBoxItem Content="韩语 (KO)" Tag="ko"/>
                        <ComboBoxItem Content="法语 (FR)" Tag="fr"/>
                        <ComboBoxItem Content="德语 (DE)" Tag="de"/>
                        <ComboBoxItem Content="西班牙语" Tag="es"/>
                        <ComboBoxItem Content="俄语 (RU)" Tag="ru"/>
                    </ComboBox>

                    <ui:Button Appearance="Transparent"
                               Content="⇄"
                               ToolTip="交换语言"
                               Margin="2,0"
                               Width="26" Height="26"
                               Padding="0"
                               CornerRadius="13"
                               Click="OnSwapLanguageClick"
                               FontWeight="Bold"
                               FontSize="13"/>

                    <ComboBox x:Name="CmbTargetLang"
                              MinWidth="125"
                              Height="32"
                              FontSize="12.5"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center"
                              Padding="10,0,24,0"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="中文 (简体)" Tag="zh-Hans"/>
                        <ComboBoxItem Content="英语 (EN)" Tag="en"/>
                        <ComboBoxItem Content="日语 (JA)" Tag="ja"/>
                        <ComboBoxItem Content="韩语 (KO)" Tag="ko"/>
                        <ComboBoxItem Content="法语 (FR)" Tag="fr"/>
                        <ComboBoxItem Content="德语 (DE)" Tag="de"/>
                        <ComboBoxItem Content="西班牙语" Tag="es"/>
                        <ComboBoxItem Content="俄语 (RU)" Tag="ru"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 右侧：服务商与设置 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="CmbProvider"
                          MinWidth="140"
                          Height="34"
                          FontSize="12.5"
                          Margin="0,0,8,0"
                          Padding="10,0,26,0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="OnProviderChanged">
                    <ComboBoxItem Content="Microsoft 翻译" IsSelected="True" Tag="microsoft"/>
                    <ComboBoxItem Content="Google 翻译" Tag="google"/>
                    <ComboBoxItem Content="FreeAI 翻译" Tag="freeai"/>
                    <ComboBoxItem Content="OpenAI 兼容" Tag="openaicompatible"/>
                </ComboBox>

                <ui:Button x:Name="BtnPin"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Pin24}"
                           Width="34" Height="34"
                           Padding="0"
                           Margin="0,0,6,0"
                           ToolTip="置顶窗口"
                           Click="OnTogglePinClick"/>

                <ui:Button Appearance="Secondary"
                           Icon="{ui:SymbolIcon Settings24}"
                           Width="34" Height="34"
                           Padding="0"
                           ToolTip="偏好设置"
                           Click="OnOpenSettingsClick"/>
            </StackPanel>
        </Grid>

        <!-- 2. 主体左右双栏卡片 -->
        <Grid Grid.Row="2" Margin="20,0,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：原文卡片 -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 原文头部：左侧固定“原文”，右侧吸附在卡片最右侧 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：原文 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Document24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="原文" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 右侧吸边：朗读 + 清空 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ui:Button x:Name="BtnSpeakSource"
                                       Appearance="Transparent"
                                       Icon="{ui:SymbolIcon Speaker224}"
                                       Width="26" Height="26"
                                       Padding="0"
                                       BorderThickness="0"
                                       CornerRadius="13"
                                       ToolTip="朗读原文"
                                       Margin="0,0,4,0"
                                       Opacity="0.4"
                                       IsEnabled="False"
                                       Click="OnSpeakSourceClick"/>

                            <ui:Button x:Name="BtnClearSource"
                                       Appearance="Transparent"
                                       Icon="{ui:SymbolIcon DismissCircle24}"
                                       Width="26" Height="26"
                                       Padding="0"
                                       BorderThickness="0"
                                       CornerRadius="13"
                                       ToolTip="清空内容"
                                       Opacity="0.4"
                                       IsEnabled="False"
                                       Click="OnClearClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- 原文输入框 -->
                    <Grid Grid.Row="1">
                        <TextBox x:Name="TxtSource"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 Foreground="#1F2937"
                                 Padding="0"
                                 Margin="0"
                                 FocusVisualStyle="{x:Null}"
                                 TextChanged="OnSourceTextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock Text="输入或在此粘贴需要翻译的内容…"
                                   Foreground="#9CA3AF"
                                   FontSize="14"
                                   IsHitTestVisible="False"
                                   Margin="0,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSource}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- 中间分割 -->
            <Grid Grid.Column="1"/>

            <!-- 右栏：译文卡片 -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 译文头部：左侧固定“译文”，右侧吸附在卡片最右侧 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：译文 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="译文" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 右侧吸边：翻译中转圈动画 + 朗读译文 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ui:ProgressRing x:Name="PrgTranslating"
                                             IsIndeterminate="True"
                                             Width="16" Height="16"
                                             Margin="0,0,8,0"
                                             Visibility="Collapsed"
                                             VerticalAlignment="Center"/>

                            <ui:Button x:Name="BtnSpeakTarget"
                                       Appearance="Transparent"
                                       Icon="{ui:SymbolIcon Speaker224}"
                                       Width="26" Height="26"
                                       Padding="0"
                                       BorderThickness="0"
                                       CornerRadius="13"
                                       ToolTip="朗读译文"
                                       Opacity="0.4"
                                       IsEnabled="False"
                                       Click="OnSpeakTargetClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- 译文输出框 (对齐 macOS：翻译中显示“正在思考与翻译…”) -->
                    <Grid Grid.Row="1">
                        <TextBox x:Name="TxtTarget"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14.5"
                                 FontWeight="Medium"
                                 Foreground="#111827"
                                 Padding="0"
                                 Margin="0"
                                 FocusVisualStyle="{x:Null}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock x:Name="TxtTargetPlaceholder"
                                   Text="翻译结果将在这里呈现…"
                                   Foreground="#9CA3AF"
                                   FontSize="14"
                                   IsHitTestVisible="False"
                                   Margin="0,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtTarget}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. 底部悬浮动作胶囊 (纯净居中胶囊，无左下角多余状态文字) -->
        <Grid Grid.Row="3" Margin="20,0,20,16" VerticalAlignment="Center">
            <!-- 居中纯净扁平悬浮动作胶囊 -->
            <Border HorizontalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="6,3">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 清空 -->
                    <ui:Button Appearance="Transparent"
                               Icon="{ui:SymbolIcon Delete24}"
                               ToolTip="清空全部"
                               Width="32" Height="30"
                               Padding="0"
                               BorderThickness="0"
                               CornerRadius="15"
                               Click="OnClearClick"/>

                    <!-- 朗读 -->
                    <ui:Button Appearance="Transparent"
                               Icon="{ui:SymbolIcon Speaker224}"
                               ToolTip="朗读当前内容"
                               Width="32" Height="30"
                               Padding="0"
                               BorderThickness="0"
                               CornerRadius="15"
                               Margin="2,0,0,0"
                               Click="OnSpeakActiveClick"/>

                    <Rectangle Width="1" Height="14" Fill="#E5E7EB" Margin="6,0,6,0" VerticalAlignment="Center"/>

                    <!-- 复制 -->
                    <ui:Button Appearance="Transparent"
                               Icon="{ui:SymbolIcon Copy24}"
                               Content="复制"
                               ToolTip="复制译文"
                               Height="30"
                               FontSize="12.5"
                               BorderThickness="0"
                               CornerRadius="15"
                               Padding="10,0"
                               Margin="0,0,4,0"
                               Click="OnCopyTargetClick"/>

                    <!-- 翻译 (Ctrl+Enter) -->
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon Translate24}"
                               Content="翻译 (Ctrl+Enter)"
                               Height="30"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               CornerRadius="15"
                               Padding="16,0"
                               Click="OnTranslateClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
