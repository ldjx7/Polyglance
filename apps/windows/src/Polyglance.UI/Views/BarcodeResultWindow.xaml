<Window x:Class="Polyglance.UI.Views.BarcodeResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        KeyDown="OnKeyDown">
    <Grid>
        <Border BorderBrush="#FF0A84FF"
                BorderThickness="2"
                CornerRadius="3"
                ClipToBounds="True">
            <Image x:Name="PreviewImage" Stretch="Fill"/>
        </Border>

        <Canvas x:Name="MarkerCanvas" Background="Transparent"/>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="7"
                Height="26"
                Padding="9,0"
                CornerRadius="13"
                Background="#EFFFFFFF"
                BorderBrush="#24000000"
                BorderThickness="1">
            <TextBlock x:Name="HeaderText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#FF202124"/>
        </Border>

        <Button x:Name="BtnClose"
                Content="✕"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="7"
                Width="26"
                Height="26"
                Padding="0"
                FontSize="11"
                Background="#EFFFFFFF"
                BorderBrush="#24000000"
                BorderThickness="1"
                Foreground="#FF5F6368"
                Cursor="Hand"
                ToolTip="关闭二维码识别"
                Click="OnCloseClick"/>
    </Grid>
</Window>
