<UserControl x:Class="Polyglance.UI.Controls.ScreenshotToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <!-- 与 macOS ScreenshotToolbarButton 相同的视觉令牌。 -->
        <SolidColorBrush x:Key="ToolbarIconBrush" Color="#FF2E2E2E"/>
        <SolidColorBrush x:Key="ToolbarHoverIconBrush" Color="#FF141414"/>
        <SolidColorBrush x:Key="ToolbarActiveBrush" Color="#FF0A84FF"/>
        <SolidColorBrush x:Key="ToolbarActiveBackgroundBrush" Color="#1F0A84FF"/>
        <SolidColorBrush x:Key="ToolbarHoverBackgroundBrush" Color="#14000000"/>
        <SolidColorBrush x:Key="ToolbarPressedBackgroundBrush" Color="#1F000000"/>
        <SolidColorBrush x:Key="ToolbarDisabledBrush" Color="#33000000"/>
        <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#14000000"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ToolbarIconBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ToolbarHoverIconBrush}"/>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource ToolbarHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource ToolbarPressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ToolbarDisabledBrush}"/>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DividerStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Fill" Value="#18000000"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <!-- 样式选择目前固定为跨端一致的默认值；不在截图内容上再叠一层菜单。 -->
        <Border x:Name="SubToolbarBorder"
                Background="#FFFFFF"
                BorderBrush="{StaticResource ToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="8,4"
                Margin="0,0,0,6"
                HorizontalAlignment="Center"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="12" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton GroupName="StrokeSize" Margin="2,0" VerticalAlignment="Center" Cursor="Hand" Checked="OnStrokeSizeChecked" Tag="2">
                    <Ellipse Width="4" Height="4" Fill="#333333"/>
                </RadioButton>
                <RadioButton GroupName="StrokeSize" Margin="4,0" IsChecked="True" VerticalAlignment="Center" Cursor="Hand" Checked="OnStrokeSizeChecked" Tag="4">
                    <Ellipse Width="8" Height="8" Fill="#333333"/>
                </RadioButton>
                <RadioButton GroupName="StrokeSize" Margin="2,0" VerticalAlignment="Center" Cursor="Hand" Checked="OnStrokeSizeChecked" Tag="8">
                    <Ellipse Width="12" Height="12" Fill="#333333"/>
                </RadioButton>

                <Rectangle Style="{StaticResource DividerStyle}"/>

                <RadioButton GroupName="ColorPicker" Margin="3,0" IsChecked="True" Cursor="Hand" Checked="OnColorChecked" Tag="#EF4444">
                    <Ellipse Width="16" Height="16" Fill="#EF4444" Stroke="#30000000" StrokeThickness="1"/>
                </RadioButton>
                <RadioButton GroupName="ColorPicker" Margin="3,0" Cursor="Hand" Checked="OnColorChecked" Tag="#F97316">
                    <Ellipse Width="16" Height="16" Fill="#F97316" Stroke="#30000000" StrokeThickness="1"/>
                </RadioButton>
                <RadioButton GroupName="ColorPicker" Margin="3,0" Cursor="Hand" Checked="OnColorChecked" Tag="#FACC15">
                    <Ellipse Width="16" Height="16" Fill="#FACC15" Stroke="#30000000" StrokeThickness="1"/>
                </RadioButton>
                <RadioButton GroupName="ColorPicker" Margin="3,0" Cursor="Hand" Checked="OnColorChecked" Tag="#10B981">
                    <Ellipse Width="16" Height="16" Fill="#10B981" Stroke="#30000000" StrokeThickness="1"/>
                </RadioButton>
                <RadioButton GroupName="ColorPicker" Margin="3,0" Cursor="Hand" Checked="OnColorChecked" Tag="#3B82F6">
                    <Ellipse Width="16" Height="16" Fill="#3B82F6" Stroke="#30000000" StrokeThickness="1"/>
                </RadioButton>
                <RadioButton GroupName="ColorPicker" Margin="3,0" Cursor="Hand" Checked="OnColorChecked" Tag="#8B5CF6">
                    <Ellipse Width="16" Height="16" Fill="#8B5CF6" Stroke="#30000000" StrokeThickness="1"/>
                </RadioButton>
                <RadioButton GroupName="ColorPicker" Margin="3,0" Cursor="Hand" Checked="OnColorChecked" Tag="#1F2937">
                    <Ellipse Width="16" Height="16" Fill="#1F2937" Stroke="#30000000" StrokeThickness="1"/>
                </RadioButton>
                <RadioButton GroupName="ColorPicker" Margin="3,0" Cursor="Hand" Checked="OnColorChecked" Tag="#FFFFFF">
                    <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#60000000" StrokeThickness="1.5"/>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 一级主工具栏：结构、图标颜色和交互状态与 macOS 保持一致。 -->
        <Border x:Name="MainToolbarBorder"
                Background="#FFFFFF"
                BorderBrush="{StaticResource ToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="10,5">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.16" BlurRadius="16" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <StackPanel x:Name="ToolbarRows" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="ToolRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPen" Style="{StaticResource ToolbarButtonStyle}" ToolTip="画笔" AutomationProperties.Name="画笔" Click="OnToolClicked" Tag="Pen">
                        <Path Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnRect" Style="{StaticResource ToolbarButtonStyle}" ToolTip="矩形" AutomationProperties.Name="矩形" Click="OnToolClicked" Tag="Rect">
                        <Path Data="M3,3 H21 V21 H3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnEllipse" Style="{StaticResource ToolbarButtonStyle}" ToolTip="椭圆" AutomationProperties.Name="椭圆" Click="OnToolClicked" Tag="Ellipse">
                        <Ellipse Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/>
                    </Button>
                    <Button x:Name="BtnArrow" Style="{StaticResource ToolbarButtonStyle}" ToolTip="箭头" AutomationProperties.Name="箭头" Click="OnToolClicked" Tag="Arrow">
                        <Path Data="M4,18 L18,4 M18,4 L9,4 M18,4 L18,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnText" Style="{StaticResource ToolbarButtonStyle}" ToolTip="文字" AutomationProperties.Name="文字" Click="OnToolClicked" Tag="Text">
                        <TextBlock Text="T" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe UI, Arial"/>
                    </Button>
                    <Button x:Name="BtnMosaic" Style="{StaticResource ToolbarButtonStyle}" ToolTip="马赛克" AutomationProperties.Name="马赛克" Click="OnToolClicked" Tag="Mosaic">
                        <Path Data="M2,2 H8 V8 H2 Z M9,2 H15 V8 H9 Z M16,2 H22 V8 H16 Z M2,9 H8 V15 H2 Z M9,9 H15 V15 H9 Z M16,9 H22 V15 H16 Z M2,16 H8 V22 H2 Z M9,16 H15 V22 H9 Z M16,16 H22 V22 H16 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnNumber" Style="{StaticResource ToolbarButtonStyle}" ToolTip="序号" AutomationProperties.Name="序号" Click="OnToolClicked" Tag="Number">
                        <Grid Width="16" Height="16">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/>
                            <TextBlock Text="1" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="ActionRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUndo" Style="{StaticResource ToolbarButtonStyle}" ToolTip="撤销" AutomationProperties.Name="撤销" Click="OnActionClicked" Tag="Undo" IsEnabled="False">
                        <Path Data="M12.5,8 C9.5,8 6.9,9.3 5.2,11.3 L2,8 V16 H10 L6.6,12.6 C7.9,11 9.9,10 12.5,10 C16.6,10 20,13.4 20,17.5 C20,18.5 19.8,19.4 19.4,20.2 L21.1,21.1 C21.7,19.9 22,18.7 22,17.5 C22,12.3 17.7,8 12.5,8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource ToolbarButtonStyle}" ToolTip="重做" AutomationProperties.Name="重做" Click="OnActionClicked" Tag="Redo" IsEnabled="False">
                        <Path Data="M18.8,11.3 C17.1,9.3 14.5,8 11.5,8 C6.3,8 2,12.3 2,17.5 C2,18.7 2.3,19.9 2.9,21.1 L4.6,20.2 C4.2,19.4 4,18.5 4,17.5 C4,13.4 7.4,10 11.5,10 C14.1,10 16.1,11 17.4,12.6 L14,16 H22 V8 L18.8,11.3 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnFinish" Style="{StaticResource ToolbarButtonStyle}" ToolTip="完成标注" AutomationProperties.Name="完成标注" Click="OnActionClicked" Tag="Finish" Visibility="Collapsed">
                        <Path Data="M4,12 L9,17 L20,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnOCR" Style="{StaticResource ToolbarButtonStyle}" ToolTip="OCR" AutomationProperties.Name="OCR" Click="OnActionClicked" Tag="OCR">
                        <Grid Width="16" Height="16">
                            <Path Data="M1,6 V1 H6 M10,1 H15 V6 M15,10 V15 H10 M6,15 H1 V10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M4,6 H12 M4,9 H12 M4,12 H9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnTranslate" Style="{StaticResource ToolbarButtonStyle}" ToolTip="OCR翻译" AutomationProperties.Name="OCR翻译" Click="OnActionClicked" Tag="OCRTranslate">
                        <Grid Width="16" Height="16">
                            <Path Data="M2,2 H10 C11.1,2 12,2.9 12,4 V9 C12,10.1 11.1,11 10,11 H7 L4,14 V11 H2 C0.9,11 0,10.1 0,9 V4 C0,2.9 0.9,2 2,2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeLineJoin="Round" Fill="Transparent"/>
                            <Path Data="M4,5 H9 M6.5,4 V5 C6.5,7 5.5,8.4 4,9 M6.5,7.2 C7.3,8 8.1,8.6 9,9 M9,12 H14 M11.5,10 V15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnLongScreenshot" Style="{StaticResource ToolbarButtonStyle}" ToolTip="长截图" AutomationProperties.Name="长截图" Click="OnActionClicked" Tag="LongScreenshot">
                        <Path Data="M6,2 H18 C19.1,2 20,2.9 20,4 V20 C20,21.1 19.1,22 18,22 H6 C4.9,22 4,21.1 4,20 V4 C4,2.9 4.9,2 6,2 Z M12,6 V18 M9,9 L12,6 L15,9 M9,15 L12,18 L15,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnScreenRecording" Style="{StaticResource ToolbarButtonStyle}" ToolTip="录屏" AutomationProperties.Name="录屏" Click="OnActionClicked" Tag="ScreenRecording">
                        <Grid Width="14" Height="14">
                            <Ellipse Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                            <Ellipse Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnPin" Style="{StaticResource ToolbarButtonStyle}" ToolTip="贴图" AutomationProperties.Name="贴图" Click="OnActionClicked" Tag="Pin">
                        <Path Data="M16,12 V4 H17 V2 H7 V4 H8 V12 L6,14 V16 H11 V22 L12,23 L13,22 V16 H18 V14 L16,12 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnSave" Style="{StaticResource ToolbarButtonStyle}" ToolTip="保存" AutomationProperties.Name="保存" Click="OnActionClicked" Tag="Save">
                        <Path Data="M12,3 V15 M8,11 L12,15 L16,11 M5,17 V21 H19 V17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnCancel" Style="{StaticResource ToolbarButtonStyle}" ToolTip="取消" AutomationProperties.Name="取消" Click="OnActionClicked" Tag="Cancel">
                        <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnCopy" Style="{StaticResource ToolbarButtonStyle}" ToolTip="复制" AutomationProperties.Name="复制" Click="OnActionClicked" Tag="Copy">
                        <Path Data="M16,3 H5 C3.9,3 3,3.9 3,5 V16 M8,7 H19 C20.1,7 21,7.9 21,9 V20 C21,21.1 20.1,22 19,22 H8 C6.9,22 6,21.1 6,20 V9 C6,7.9 6.9,7 8,7 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
