<UserControl x:Class="Polyglance.UI.Controls.ScreenshotToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Polyglance.UI.Controls"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <!-- 与 macOS ScreenshotToolbarButton 相同的视觉令牌。 -->
        <SolidColorBrush x:Key="ToolbarIconBrush" Color="#FF2E2E2E"/>
        <SolidColorBrush x:Key="ToolbarTextBrush" Color="#FF2E2E2E"/>
        <SolidColorBrush x:Key="ToolbarHoverIconBrush" Color="#FF141414"/>
        <SolidColorBrush x:Key="ToolbarActiveBrush" Color="#FF0A84FF"/>
        <SolidColorBrush x:Key="ToolbarActiveBackgroundBrush" Color="#1F0A84FF"/>
        <SolidColorBrush x:Key="ToolbarHoverBackgroundBrush" Color="#14000000"/>
        <SolidColorBrush x:Key="ToolbarPressedBackgroundBrush" Color="#1F000000"/>
        <SolidColorBrush x:Key="ToolbarDisabledBrush" Color="#33000000"/>
        <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#14000000"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ToolbarIconBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ToolbarHoverIconBrush}"/>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource ToolbarHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource ToolbarPressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ToolbarDisabledBrush}"/>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarSubButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Background" Value="#0F000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnSurface" Property="Background" Value="#1A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnSurface" Property="Background" Value="#25000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="#00000000" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0EDFF"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E5EDFF"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="#0F000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MaxDropDownHeight" Value="450"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="5,0"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#1A000000"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#25000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="4,0"/>
                            <Popup x:Name="PART_Popup"
                                    AllowsTransparency="True"
                                    StaysOpen="True"
                                    IsOpen="{TemplateBinding IsDropDownOpen}"
                                    Placement="{Binding Path=PopupPlacement, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenshotToolbar}}, FallbackValue=Bottom}"
                                    PopupAnimation="Slide"
                                    Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,2,0,4"
                                        Padding="4"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="24" Height="24" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Ellipse x:Name="OuterRing" Width="20" Height="20" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="InnerDot" Width="14" Height="14" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterRing" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="InnerDot" Property="Width" Value="12"/>
                                <Setter TargetName="InnerDot" Property="Height" Value="12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TightCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="2,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RootBorder" Background="Transparent" CornerRadius="4" Padding="4,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border x:Name="Box" Width="13" Height="13" CornerRadius="3" BorderBrush="#9CA3AF" BorderThickness="1.2" Background="Transparent" VerticalAlignment="Center">
                                    <Path x:Name="CheckMark" Data="M 2,5.5 L 5,8.5 L 10.5,2.5" Stroke="#2563EB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Content="{TemplateBinding Content}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Box" Property="Background" Value="#152563EB"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#0D000000"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DividerStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="#1A000000"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="ToolbarContainer" Orientation="Vertical">
        <!-- 一级主工具栏：结构、图标颜色和交互状态与 macOS 保持一致。 -->
        <Border x:Name="MainToolbarBorder"
                Background="#FFFFFF"
                BorderBrush="{StaticResource ToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="10,5"
                HorizontalAlignment="Left"
                Cursor="SizeAll"
                MouseLeftButtonDown="OnMainToolbarMouseDown"
                MouseMove="OnMainToolbarMouseMove"
                MouseLeftButtonUp="OnMainToolbarMouseUp">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.16" BlurRadius="16" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <StackPanel x:Name="ToolbarRows" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="ToolRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPen" Style="{StaticResource ToolbarButtonStyle}" ToolTip="画笔" AutomationProperties.Name="画笔" Click="OnToolClicked" Tag="Pen">
                        <Path Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnRect" Style="{StaticResource ToolbarButtonStyle}" ToolTip="矩形" AutomationProperties.Name="矩形" Click="OnToolClicked" Tag="Rect">
                        <Path Data="M3,3 H21 V21 H3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnEllipse" Style="{StaticResource ToolbarButtonStyle}" ToolTip="椭圆" AutomationProperties.Name="椭圆" Click="OnToolClicked" Tag="Ellipse">
                        <Ellipse Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/>
                    </Button>
                    <Button x:Name="BtnLine" Style="{StaticResource ToolbarButtonStyle}" ToolTip="线条" AutomationProperties.Name="线条" Click="OnToolClicked" Tag="Line">
                        <Path Data="M4,18 L18,4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnArrow" Style="{StaticResource ToolbarButtonStyle}" ToolTip="箭头" AutomationProperties.Name="箭头" Click="OnToolClicked" Tag="Arrow">
                        <Path Data="M4,18 L18,4 M18,4 L9,4 M18,4 L18,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnText" Style="{StaticResource ToolbarButtonStyle}" ToolTip="文字" AutomationProperties.Name="文字" Click="OnToolClicked" Tag="Text">
                        <TextBlock Text="T" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe UI, Arial"/>
                    </Button>
                    <Button x:Name="BtnMosaic" Style="{StaticResource ToolbarButtonStyle}" ToolTip="马赛克" AutomationProperties.Name="马赛克" Click="OnToolClicked" Tag="Mosaic">
                        <Path Data="M3,3 H9 V9 H3 Z M11,3 H17 V9 H11 Z M19,3 H21 V9 H19 Z M3,11 H9 V17 H3 Z M11,11 H17 V17 H11 Z M19,11 H21 V17 H19 Z M3,19 H9 V21 H3 Z M11,19 H17 V21 H11 Z M19,19 H21 V21 H19 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnNumber" Style="{StaticResource ToolbarButtonStyle}" ToolTip="序号" AutomationProperties.Name="序号" Click="OnToolClicked" Tag="Number">
                        <Grid Width="16" Height="16">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                            <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <Rectangle Style="{StaticResource DividerStyle}"/>

                <StackPanel x:Name="ActionRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUndo" Style="{StaticResource ToolbarButtonStyle}" ToolTip="撤销" AutomationProperties.Name="撤销" Click="OnActionClicked" Tag="Undo" IsEnabled="False">
                        <Path Data="M12.5,8 C9.85,8 7.45,9 5.6,10.6 L2,7 V16 H11 L7.38,12.38 C8.77,11.22 10.54,10.5 12.5,10.5 C16.04,10.5 19.05,12.81 20.1,16 L22.47,15.22 C21.08,11.01 17.15,8 12.5,8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource ToolbarButtonStyle}" ToolTip="重做" AutomationProperties.Name="重做" Click="OnActionClicked" Tag="Redo" IsEnabled="False">
                        <Path Data="M18.4,10.6 C16.55,9 14.15,8 11.5,8 C6.85,8 2.92,11.01 1.53,15.22 L3.9,16 C4.95,12.81 7.96,10.5 11.5,10.5 C13.46,10.5 15.23,11.22 16.62,12.38 L13,16 H22 V7 L18.4,10.6 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnFinish" Style="{StaticResource ToolbarButtonStyle}" ToolTip="完成标注" AutomationProperties.Name="完成标注" Click="OnActionClicked" Tag="Finish" Visibility="Collapsed">
                        <Path Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z" Fill="#10B981" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnOCR" Style="{StaticResource ToolbarButtonStyle}" ToolTip="文字识别 (OCR)" AutomationProperties.Name="文字识别 (OCR)" Click="OnActionClicked" Tag="OCR">
                        <Path Data="M3,5 V3 H5 M19,3 H21 V5 M3,19 V21 H5 M19,21 H21 V19 M7,7 H17 V9 H13 V17 H11 V9 H7 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnTranslate" Style="{StaticResource ToolbarButtonStyle}" ToolTip="识别并翻译" AutomationProperties.Name="识别并翻译" Click="OnActionClicked" Tag="OCRTranslate">
                        <Path Data="M12.87,15.07 L10.33,12.56 L10.36,12.53 C12.1,10.59 13.34,8.36 14.07,6 H17 V4 H10 V2 H8 V4 H1 V6 H12.17 C11.5,7.92 10.44,9.75 9,11.35 C8.07,10.32 7.3,9.19 6.69,8 H4.69 C5.42,9.63 6.42,11.17 7.67,12.56 L2.58,17.58 L4,19 L9,14 L12.11,17.11 L12.87,15.07 Z M18.5,10 H16.5 L12,22 H14 L15.12,19 H19.87 L21,22 H23 L18.5,10 Z M15.88,17 L17.5,12.67 L19.12,17 H15.88 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnBarcode" Style="{StaticResource ToolbarButtonStyle}" ToolTip="二维码/条形码识别" AutomationProperties.Name="二维码/条形码识别" Click="OnActionClicked" Tag="Barcode">
                        <Path Data="M2,4 H5 V20 H2 Z M7,4 H8 V20 H7 Z M10,4 H13 V20 H10 Z M15,4 H16 V20 H16 Z M18,4 H21 V20 H18 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnLongScreenshot" Style="{StaticResource ToolbarButtonStyle}" ToolTip="长截图" AutomationProperties.Name="长截图" Click="OnActionClicked" Tag="LongScreenshot">
                        <Path Data="M6,2 H18 C19.1,2 20,2.9 20,4 V20 C20,21.1 19.1,22 18,22 H6 C4.9,22 4,21.1 4,20 V4 C4,2.9 4.9,2 6,2 Z M12,6 V18 M9,9 L12,6 L15,9 M9,15 L12,18 L15,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnScreenRecording" Style="{StaticResource ToolbarButtonStyle}" ToolTip="录屏" AutomationProperties.Name="录屏" Click="OnActionClicked" Tag="ScreenRecording">
                        <Grid Width="14" Height="14">
                            <Ellipse Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                            <Ellipse Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnPin" Style="{StaticResource ToolbarButtonStyle}" ToolTip="贴图" AutomationProperties.Name="贴图" Click="OnActionClicked" Tag="Pin">
                        <Path Data="M16,12 V4 H17 V2 H7 V4 H8 V12 L6,14 V16 H11 V22 L12,23 L13,22 V16 H18 V14 L16,12 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnSave" Style="{StaticResource ToolbarButtonStyle}" ToolTip="保存" AutomationProperties.Name="保存" Click="OnActionClicked" Tag="Save">
                        <Path Data="M12,3 V15 M8,11 L12,15 L16,11 M5,17 V21 H19 V17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnCancel" Style="{StaticResource ToolbarButtonStyle}" ToolTip="取消" AutomationProperties.Name="取消" Click="OnActionClicked" Tag="Cancel">
                        <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnCopy" Style="{StaticResource ToolbarButtonStyle}" ToolTip="复制" AutomationProperties.Name="复制" Click="OnActionClicked" Tag="Copy">
                        <Path Data="M16,3 H5 C3.9,3 3,3.9 3,5 V16 M8,7 H19 C20.1,7 21,7.9 21,9 V20 C21,21.1 20.1,22 19,22 H8 C6.9,22 6,21.1 6,20 V9 C6,7.9 6.9,7 8,7 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 动态二级属性子工具栏：根据选中的工具展示对应属性（线宽/虚线/填充/字号/马赛克/调色盘） -->
        <Border x:Name="SubToolbarBorder"
                Height="32"
                Background="#FFFFFF"
                BorderBrush="{StaticResource ToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="8,3"
                Margin="0,6,0,0"
                HorizontalAlignment="Left"
                Visibility="Collapsed"
                PreviewMouseWheel="OnSubToolbarMouseWheel">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="12" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 矩形 / 椭圆属性组 (填充复选框 + 线条样式图形下拉框) -->
                <StackPanel x:Name="PanelRectControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <CheckBox x:Name="ChkFilled" Style="{StaticResource TightCheckBoxStyle}" Content="填充" IsChecked="False" Checked="OnFillCheckChanged" Unchecked="OnFillCheckChanged"/>
                    <ComboBox x:Name="CmbRectDash" Style="{StaticResource ToolbarComboBoxStyle}" Width="72" SelectionChanged="OnRectDashChanged" DropDownOpened="OnComboBoxDropDownOpened">
                        <ComboBoxItem IsSelected="True" ToolTip="实线">
                            <Line X1="0" Y1="0" X2="48" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="长虚线">
                            <Line X1="0" Y1="0" X2="48" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2" StrokeDashArray="4 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="点线">
                            <Line X1="0" Y1="0" X2="48" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2" StrokeDashArray="1 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="点划线">
                            <Line X1="0" Y1="0" X2="48" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2" StrokeDashArray="6 2 1 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- 箭头/线条属性组 (9种箭头样式 + 4种线条虚实样式图形下拉框) -->
                <StackPanel x:Name="PanelLineControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <ComboBox x:Name="CmbArrowStyle" Style="{StaticResource ToolbarComboBoxStyle}" Width="66" MaxDropDownHeight="450" SelectionChanged="OnArrowStyleChanged" DropDownOpened="OnComboBoxDropDownOpened">
                        <ComboBoxItem ToolTip="细单向箭头">
                            <Path Data="M 2,8 L 36,8 M 29,4.5 L 36,8 L 29,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="38" Height="16"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="细双向箭头">
                            <Path Data="M 9,4.5 L 2,8 L 9,11.5 M 2,8 L 36,8 M 29,4.5 L 36,8 L 29,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="38" Height="16"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="粗单向箭头">
                            <Path Data="M 3,8 L 35,8 M 28,4.5 L 35,8 L 28,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="38" Height="16"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="粗双向箭头">
                            <Path Data="M 10,4.5 L 3,8 L 10,11.5 M 3,8 L 35,8 M 28,4.5 L 35,8 L 28,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="38" Height="16"/>
                        </ComboBoxItem>
                        <ComboBoxItem IsSelected="True" ToolTip="空心左小右大箭头">
                            <Path Data="M 2,7.2 L 25,5.8 L 25,3 L 36,8 L 25,13 L 25,10.2 L 2,8.8 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="1.2" StrokeLineJoin="Round" Fill="Transparent" Width="38" Height="16"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="实心左小右大箭头">
                            <Path Data="M 2,7.2 L 25,5.8 L 25,3 L 36,8 L 25,13 L 25,10.2 L 2,8.8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" Width="38" Height="16"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="双向T型端点线">
                            <Path Data="M 2,3.5 L 2,12.5 M 2,8 L 36,8 M 36,3.5 L 36,12.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="38" Height="16"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="单向实心三角箭头">
                            <Canvas Width="38" Height="16">
                                <Line X1="2" Y1="8" X2="27" Y2="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                                <Polygon Points="36,8 26,4.5 26,11.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}"/>
                            </Canvas>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="双向实心三角箭头">
                            <Canvas Width="38" Height="16">
                                <Line X1="11" Y1="8" X2="27" Y2="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="1.6"/>
                                <Polygon Points="2,8 12,4.5 12,11.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}"/>
                                <Polygon Points="36,8 26,4.5 26,11.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}"/>
                            </Canvas>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="双向T型端点带箭头">
                            <Path Data="M 2,3.5 L 2,12.5 M 8,5 L 2,8 L 8,11 M 2,8 L 36,8 M 30,5 L 36,8 L 30,11 M 36,3.5 L 36,12.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="38" Height="16"/>
                        </ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="CmbLineDash" Style="{StaticResource ToolbarComboBoxStyle}" Width="72" SelectionChanged="OnLineDashChanged" DropDownOpened="OnComboBoxDropDownOpened">
                        <ComboBoxItem IsSelected="True" ToolTip="实线">
                            <Line X1="0" Y1="0" X2="48" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="长虚线">
                            <Line X1="0" Y1="0" X2="48" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2" StrokeDashArray="4 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="点线">
                            <Line X1="0" Y1="0" X2="48" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2" StrokeDashArray="1 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ComboBoxItem>
                        <ComboBoxItem ToolTip="点划线">
                            <Line X1="0" Y1="0" X2="48" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=#2E2E2E}" StrokeThickness="2" StrokeDashArray="6 2 1 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- 文字属性组 (字体/字号下拉框 + 粗斜体) -->
                <StackPanel x:Name="PanelTextControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <ComboBox x:Name="CmbFontFamily" Style="{StaticResource ToolbarComboBoxStyle}" Width="86" SelectionChanged="OnFontFamilyChanged" DropDownOpened="OnComboBoxDropDownOpened">
                        <ComboBoxItem Content="系统默认" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei"/>
                        <ComboBoxItem Content="宋体" Tag="SimSun"/>
                        <ComboBoxItem Content="黑体" Tag="SimHei"/>
                        <ComboBoxItem Content="楷体" Tag="KaiTi"/>
                        <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                        <ComboBoxItem Content="Arial" Tag="Arial"/>
                        <ComboBoxItem Content="Georgia" Tag="Georgia"/>
                        <ComboBoxItem Content="Courier New" Tag="Courier New"/>
                        <ComboBoxItem Content="Times New Roman" Tag="Times New Roman"/>
                    </ComboBox>
                    <ComboBox x:Name="CmbFontSize" Style="{StaticResource ToolbarComboBoxStyle}" Width="62" SelectionChanged="OnFontSizeChanged" DropDownOpened="OnComboBoxDropDownOpened">
                        <ComboBoxItem Content="12 pt" Tag="12"/>
                        <ComboBoxItem Content="14 pt" Tag="14"/>
                        <ComboBoxItem Content="16 pt" Tag="16" IsSelected="True"/>
                        <ComboBoxItem Content="18 pt" Tag="18"/>
                        <ComboBoxItem Content="20 pt" Tag="20"/>
                        <ComboBoxItem Content="24 pt" Tag="24"/>
                        <ComboBoxItem Content="28 pt" Tag="28"/>
                        <ComboBoxItem Content="32 pt" Tag="32"/>
                        <ComboBoxItem Content="36 pt" Tag="36"/>
                        <ComboBoxItem Content="48 pt" Tag="48"/>
                        <ComboBoxItem Content="64 pt" Tag="64"/>
                        <ComboBoxItem Content="72 pt" Tag="72"/>
                    </ComboBox>
                    <Button x:Name="BtnTextBold" Style="{StaticResource ToolbarSubButtonStyle}" Width="26" Height="24" ToolTip="加粗" Click="OnSubToolActionClicked" Tag="TextBold">
                        <TextBlock Text="B" FontSize="12" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe UI, Arial"/>
                    </Button>
                    <Button x:Name="BtnTextItalic" Style="{StaticResource ToolbarSubButtonStyle}" Width="26" Height="24" ToolTip="斜体" Click="OnSubToolActionClicked" Tag="TextItalic">
                        <TextBlock Text="I" FontSize="12" FontStyle="Italic" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe UI, Arial"/>
                    </Button>
                    <Button x:Name="BtnTextBorder" Style="{StaticResource ToolbarSubButtonStyle}" Width="26" Height="24" ToolTip="文字背景框" Click="OnSubToolActionClicked" Tag="TextBorder">
                        <Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.2" CornerRadius="2" Padding="2,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="T" FontSize="11" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- 序号属性组 (实心 / 空心切换按钮) -->
                <StackPanel x:Name="PanelNumberControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="BtnNumberFilled" Style="{StaticResource ToolbarSubButtonStyle}" Width="26" Height="24" ToolTip="实心序号" Click="OnSubToolActionClicked" Tag="NumberFilled">
                        <Grid Width="16" Height="16">
                            <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnNumberOutline" Style="{StaticResource ToolbarSubButtonStyle}" Width="26" Height="24" ToolTip="空心序号" Click="OnSubToolActionClicked" Tag="NumberOutline">
                        <Grid Width="16" Height="16">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"/>
                            <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 马赛克属性组 (下拉框) -->
                <StackPanel x:Name="PanelMosaicControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <ComboBox x:Name="CmbMosaicStyle" Style="{StaticResource ToolbarComboBoxStyle}" Width="98" SelectionChanged="OnMosaicStyleChanged" DropDownOpened="OnComboBoxDropDownOpened">
                        <ComboBoxItem Content="涂抹 · 像素" IsSelected="True"/>
                        <ComboBoxItem Content="涂抹 · 模糊"/>
                        <ComboBoxItem Content="矩形 · 像素"/>
                        <ComboBoxItem Content="矩形 · 模糊"/>
                    </ComboBox>
                </StackPanel>

                <!-- 线宽/粗细选择：数字按钮 + 点击弹出滑动条 Popup -->
                <StackPanel x:Name="PanelStrokeSizes" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStrokeSize" Style="{StaticResource ToolbarSubButtonStyle}" ToolTip="线条粗细（点击滑动条/滚轮调节）" Click="OnStrokeSizeButtonClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0" IsHitTestVisible="False">
                            <Ellipse Width="7" Height="7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock x:Name="TxtStrokeSize" Text="4" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Popup x:Name="PopupStrokeSlider"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           PlacementTarget="{Binding ElementName=BtnStrokeSize}"
                           Placement="{Binding Path=PopupPlacement, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenshotToolbar}}, FallbackValue=Top}"
                           VerticalOffset="-4"
                           PopupAnimation="Fade">
                        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="4" PreviewMouseWheel="OnSubToolbarMouseWheel">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="SliderStrokeSize"
                                        Minimum="1"
                                        Maximum="50"
                                        Value="4"
                                        Width="100"
                                        SmallChange="1"
                                        LargeChange="5"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnStrokeSliderValueChanged"/>
                                <TextBlock x:Name="TxtSliderStrokeVal"
                                           Text="4 px"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           Width="38"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <Rectangle Style="{StaticResource DividerStyle}"/>

                <!-- 调色盘：与 macOS ScreenshotColorPalette 完全一致的 8 色环形单选 -->
                <StackPanel x:Name="PanelColorPalette" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource ColorRadioStyle}" GroupName="ColorPicker" IsChecked="True" Foreground="#EF4444" Checked="OnColorChecked" Tag="#EF4444"/>
                    <RadioButton Style="{StaticResource ColorRadioStyle}" GroupName="ColorPicker" Foreground="#F97316" Checked="OnColorChecked" Tag="#F97316"/>
                    <RadioButton Style="{StaticResource ColorRadioStyle}" GroupName="ColorPicker" Foreground="#FACC15" Checked="OnColorChecked" Tag="#FACC15"/>
                    <RadioButton Style="{StaticResource ColorRadioStyle}" GroupName="ColorPicker" Foreground="#10B981" Checked="OnColorChecked" Tag="#10B981"/>
                    <RadioButton Style="{StaticResource ColorRadioStyle}" GroupName="ColorPicker" Foreground="#3B82F6" Checked="OnColorChecked" Tag="#3B82F6"/>
                    <RadioButton Style="{StaticResource ColorRadioStyle}" GroupName="ColorPicker" Foreground="#8B5CF6" Checked="OnColorChecked" Tag="#8B5CF6"/>
                    <RadioButton Style="{StaticResource ColorRadioStyle}" GroupName="ColorPicker" Foreground="#1F2937" Checked="OnColorChecked" Tag="#1F2937"/>
                    <RadioButton Style="{StaticResource ColorRadioStyle}" GroupName="ColorPicker" Foreground="#E5E7EB" Checked="OnColorChecked" Tag="#FFFFFF"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
