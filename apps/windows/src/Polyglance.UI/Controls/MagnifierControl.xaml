<UserControl x:Class="Polyglance.UI.Controls.MagnifierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="144" Height="170">
    <Border Background="#E61E1E24" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center">
            <!-- 放大采样视口 -->
            <Border Width="130" Height="100" CornerRadius="6" BorderBrush="#40FFFFFF" BorderThickness="1" ClipToBounds="True" Background="#000000">
                <Grid>
                    <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <!-- 准星标线 (高对比度双色标线) -->
                    <Line X1="0" Y1="50" X2="130" Y2="50" Stroke="#80FFFFFF" StrokeThickness="2"/>
                    <Line X1="0" Y1="50" X2="130" Y2="50" Stroke="#FFFF3B30" StrokeThickness="1"/>
                    <Line X1="65" Y1="0" X2="65" Y2="100" Stroke="#80FFFFFF" StrokeThickness="2"/>
                    <Line X1="65" Y1="0" X2="65" Y2="100" Stroke="#FFFF3B30" StrokeThickness="1"/>
                    <!-- 中心像素框 -->
                    <Rectangle Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFFF3B30" StrokeThickness="1.2"/>
                </Grid>
            </Border>

            <!-- 色值信息栏 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 当前颜色色块 -->
                <Border x:Name="ColorPreviewBox" Grid.Column="0" Width="22" Height="22" CornerRadius="4" BorderBrush="#40FFFFFF" BorderThickness="1" Background="#FFFFFF" VerticalAlignment="Center"/>

                <!-- 当前格式的色值与像素坐标 -->
                <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtColorValue" Text="#FFFFFF" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" FontFamily="Consolas, Segoe UI"/>
                    <TextBlock x:Name="TxtCoordinate" Text="(0, 0) px" Foreground="#94A3B8" FontSize="9" FontFamily="Consolas, Segoe UI"/>
                </StackPanel>
            </Grid>

            <!-- 快捷键提示 -->
            <TextBlock x:Name="TxtInstruction" Text="C 复制色值 · ⇧C 切换 HEX/RGB" Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
