<UserControl x:Class="Polyglance.UI.Controls.MagnifierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="196" Height="196">
    <!-- Every readout owns a line. Sharing one meant an RGB(255, 255, 255)
         value and the coordinate competed for about 100px and both were cut
         off, and the shortcut hint was clipped on the right. -->
    <Border Background="#E61E1E24" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="8,8,8,7">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Stretch">
            <!-- 放大采样视口 -->
            <Border Width="178" Height="100" CornerRadius="6" BorderBrush="#40FFFFFF" BorderThickness="1" ClipToBounds="True" Background="#000000">
                <Grid>
                    <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <!-- 准星标线 (高对比度双色标线)。用拉伸矩形而非固定端点的
                         Line：端点写的是外框尺寸，而线画在扣掉边框的内容区里，
                         改一次宽度就会偏移一次。 -->
                    <Rectangle Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Fill="#80FFFFFF"/>
                    <Rectangle Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Fill="#FFFF3B30"/>
                    <Rectangle Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="#80FFFFFF"/>
                    <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="#FFFF3B30"/>
                    <!-- 中心像素框 -->
                    <Rectangle Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFFF3B30" StrokeThickness="1.2"/>
                </Grid>
            </Border>

            <!-- 色值：色块与数值同行，独占一行 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                <Border x:Name="ColorPreviewBox" Width="15" Height="15" CornerRadius="3" BorderBrush="#66FFFFFF" BorderThickness="1" Background="#FFFFFF" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtColorValue" Text="#FFFFFF" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" FontFamily="Consolas, Segoe UI" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 像素坐标：独占一行 -->
            <TextBlock x:Name="TxtCoordinate" Text="(0, 0) px" Foreground="#B9C2CF" FontSize="11" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <!-- 快捷键提示：允许折行，不再被裁切 -->
            <TextBlock x:Name="TxtInstruction" Text="C 复制色值 · ⇧C 切换 HEX/RGB" Foreground="#94A3B8" FontSize="9.5" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
