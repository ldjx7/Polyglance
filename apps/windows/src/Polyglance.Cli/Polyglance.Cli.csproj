<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <AssemblyName>polyglance-csharp-cli</AssemblyName>
    <RootNamespace>Polyglance.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polyglance.Core\Polyglance.Core.csproj" />
    <ProjectReference Include="..\Polyglance.Platform\Polyglance.Platform.csproj" />
  </ItemGroup>
</Project>
