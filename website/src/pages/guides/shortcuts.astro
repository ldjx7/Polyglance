---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="快捷键列表" description="Polyglance 全局默认快捷键一览，支持自定义" lang="zh-CN">
  <div class="page-header">
    <h1 class="page-title">快捷键列表</h1>
    <p class="page-desc">所有全局快捷键均可在偏好设置中自定义修改。</p>
  </div>

  <div class="card">
    <h2 class="card-title">划词与主翻译</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>功能说明</th>
          <th>macOS 默认</th>
          <th>Windows 默认</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>取词并翻译</strong>（屏幕原地弹出翻译气泡）</td>
          <td><kbd>⌥ Option</kbd> + <kbd>D</kbd></td>
          <td><kbd>Alt</kbd> + <kbd>D</kbd></td>
        </tr>
        <tr>
          <td><strong>仅取词</strong>（选词同步到剪贴板）</td>
          <td><kbd>⌥ Option</kbd> + <kbd>⇧ Shift</kbd> + <kbd>D</kbd></td>
          <td><kbd>Alt</kbd> + <kbd>Shift</kbd> + <kbd>D</kbd></td>
        </tr>
        <tr>
          <td><strong>唤起主翻译窗口</strong></td>
          <td><kbd>⌥ Option</kbd> + <kbd>T</kbd></td>
          <td><kbd>Alt</kbd> + <kbd>T</kbd></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">截图、录屏与贴图</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>功能说明</th>
          <th>macOS 默认</th>
          <th>Windows 默认</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>高分辨率区域截图 & OCR</strong></td>
          <td><kbd>⌥ Option</kbd> + <kbd>1</kbd></td>
          <td><kbd>Alt</kbd> + <kbd>A</kbd></td>
        </tr>
        <tr>
          <td><strong>从剪贴板贴图</strong>（悬浮钉在桌面）</td>
          <td><kbd>⌥ Option</kbd> + <kbd>2</kbd></td>
          <td><kbd>Alt</kbd> + <kbd>V</kbd></td>
        </tr>
        <tr>
          <td><strong>智能滚动长截图</strong></td>
          <td><kbd>⌥ Option</kbd> + <kbd>3</kbd></td>
          <td><kbd>Alt</kbd> + <kbd>S</kbd></td>
        </tr>
        <tr>
          <td><strong>区域屏幕录制（MP4/GIF）</strong></td>
          <td><kbd>⌥ Option</kbd> + <kbd>4</kbd></td>
          <td><kbd>Alt</kbd> + <kbd>R</kbd></td>
        </tr>
        <tr>
          <td><strong>恢复最近关闭的贴图</strong></td>
          <td><kbd>⌥ Option</kbd> + <kbd>5</kbd></td>
          <td><kbd>Alt</kbd> + <kbd>Z</kbd></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">截图与 OCR 选区内部操作</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>操作动作</th>
          <th>快捷键</th>
          <th>功能作用</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>像素取色</strong></td>
          <td><kbd>C</kbd></td>
          <td>复制放大镜当前准星的像素颜色</td>
        </tr>
        <tr>
          <td><strong>切换颜色格式</strong></td>
          <td><kbd>⇧ Shift</kbd> + <kbd>C</kbd></td>
          <td>在 HEX 与 RGB 颜色代码间切换</td>
        </tr>
        <tr>
          <td><strong>复制选中 OCR 文字</strong></td>
          <td><kbd>⌘ Cmd</kbd> / <kbd>Ctrl</kbd> + <kbd>C</kbd></td>
          <td>复制框选区域中高亮的识别文本</td>
        </tr>
        <tr>
          <td><strong>退出当前操作</strong></td>
          <td><kbd>Esc</kbd></td>
          <td>关闭当前截图/选区/取色浮窗</td>
        </tr>
      </tbody>
    </table>
  </div>
</PageLayout>
