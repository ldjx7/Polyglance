---
import PageLayout from '../../layouts/PageLayout.astro';

let latestTag = 'v0.0.4-beta.9';
let macDmgUrl = `https://github.com/ldjx7/Polyglance/releases/download/${latestTag}/Polyglance-0.0.4-beta.9-macOS.dmg`;
let macZipUrl = `https://github.com/ldjx7/Polyglance/releases/download/${latestTag}/Polyglance-0.0.4-beta.9-macOS.zip`;
let winSetupUrl = `https://github.com/ldjx7/Polyglance/releases/download/${latestTag}/Polyglance-0.0.4-beta.9-Windows-x64-Setup.exe`;
let winZipUrl = `https://github.com/ldjx7/Polyglance/releases/download/${latestTag}/Polyglance-0.0.4-beta.9-Windows-x64-Portable.zip`;

try {
  const res = await fetch('https://api.github.com/repos/ldjx7/Polyglance/releases/latest');
  if (res.ok) {
    const data = await res.json();
    latestTag = data.tag_name || latestTag;
    for (const asset of data.assets || []) {
      if (asset.name.endsWith('.dmg')) macDmgUrl = asset.browser_download_url;
      else if (asset.name.includes('macOS') && asset.name.endsWith('.zip')) macZipUrl = asset.browser_download_url;
      else if (asset.name.endsWith('.exe')) winSetupUrl = asset.browser_download_url;
      else if (asset.name.includes('Windows') && asset.name.endsWith('.zip')) winZipUrl = asset.browser_download_url;
    }
  }
} catch {
  // Use fallback URLs
}
---

<PageLayout title="Download" description="Download the latest direct installer for Polyglance on macOS and Windows" lang="en">
  <div class="page-header">
    <div class="version-tag-pill">
      <span class="pulse-dot"></span>
      <span>Latest Release <strong id="latest-tag-label">{latestTag}</strong></span>
    </div>
    <h1 class="page-title">Download Polyglance</h1>
    <p class="page-desc">Direct asset download for your platform without third-party redirection.</p>
  </div>

  <div class="download-cards-grid">
    <!-- macOS Card -->
    <div class="card platform-card">
      <div class="platform-header">
        <svg style="width:26px; height:26px; fill:currentColor;" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.37c.62-.75 1.04-1.8 1.01-2.87-.96.04-2.12.64-2.8 1.44-.59.68-1.11 1.76-.97 2.8 1.07.08 2.14-.54 2.76-1.37z"/></svg>
        <div>
          <h2 class="platform-title">macOS</h2>
          <span class="platform-sub">Apple Silicon (M1-M4) &amp; Intel. Requires macOS 13.0+</span>
        </div>
      </div>

      <div class="file-group">
        <a id="link-mac-dmg" href={macDmgUrl} class="file-action-btn file-action-primary">
          <div>
            <strong>macOS Disk Image (.dmg)</strong>
            <span class="file-meta">Recommended: Drag-to-install with Sparkle auto-update</span>
          </div>
          <span class="btn-action-label">Direct Download DMG ↓</span>
        </a>

        <a id="link-mac-zip" href={macZipUrl} class="file-action-btn">
          <div>
            <strong>macOS Archive (.zip)</strong>
            <span class="file-meta">Portable archive: Extract into Applications</span>
          </div>
          <span class="btn-action-label">Direct Download ZIP ↓</span>
        </a>
      </div>

      <div class="install-tip">
        <strong>Prompted "Damaged and cannot be opened"?</strong> Run in Terminal: <code style="font-family:var(--font-code); background:var(--bg-card); padding:0.1rem 0.35rem; border-radius:4px; border:1px solid var(--border-subtle);">xattr -cr /Applications/Polyglance.app</code>
      </div>
    </div>

    <!-- Windows Card -->
    <div class="card platform-card">
      <div class="platform-header">
        <svg style="width:26px; height:26px; fill:currentColor;" viewBox="0 0 24 24"><path d="M0 0h11.377v11.377H0zm12.623 0H24v11.377H12.623zM0 12.623h11.377V24H0zm12.623 0H24V24H12.623z"/></svg>
        <div>
          <h2 class="platform-title">Windows</h2>
          <span class="platform-sub">Windows 10 (1809+) and Windows 11 64-bit</span>
        </div>
      </div>

      <div class="file-group">
        <a id="link-win-setup" href={winSetupUrl} class="file-action-btn file-action-primary">
          <div>
            <strong>Windows Installer (.exe)</strong>
            <span class="file-meta">Recommended: Per-user setup with automatic update checker</span>
          </div>
          <span class="btn-action-label">Direct Download EXE ↓</span>
        </a>

        <a id="link-win-zip" href={winZipUrl} class="file-action-btn">
          <div>
            <strong>Windows Portable (.zip)</strong>
            <span class="file-meta">Portable archive: Extract and launch Polyglance.exe directly</span>
          </div>
          <span class="btn-action-label">Direct Download ZIP ↓</span>
        </a>
      </div>

      <div class="install-tip">
        <strong>First launch note:</strong> If SmartScreen prompts, click <strong>"More info" → "Run anyway"</strong>.
      </div>
    </div>
  </div>

  <!-- Historical & More Versions Section -->
  <div class="card history-versions-card">
    <div class="history-left">
      <div class="history-icon-box">
        <svg style="width:22px; height:22px; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <div>
        <h3 class="history-title">Need older versions or source code?</h3>
        <p class="history-desc">Browse all historical release archives, changelogs, and source packages on GitHub.</p>
      </div>
    </div>

    <div class="history-actions">
      <a href="/en/changelog" class="btn-history">
        Changelog →
      </a>
      <a href="https://github.com/ldjx7/Polyglance/releases" target="_blank" rel="noopener" class="btn-history btn-history-accent">
        <svg style="width:16px; height:16px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>All Releases (GitHub) ↗</span>
      </a>
    </div>
  </div>
</PageLayout>

<script>
  // Client-side real-time direct asset link updater
  async function refreshDirectDownloadUrls() {
    try {
      const res = await fetch('https://api.github.com/repos/ldjx7/Polyglance/releases/latest');
      if (!res.ok) return;
      const release = await res.json();
      
      const tagLabel = document.getElementById('latest-tag-label');
      if (tagLabel && release.tag_name) tagLabel.textContent = release.tag_name;

      for (const asset of release.assets || []) {
        if (asset.name.endsWith('.dmg')) {
          const el = document.getElementById('link-mac-dmg');
          if (el) el.setAttribute('href', asset.browser_download_url);
        } else if (asset.name.includes('macOS') && asset.name.endsWith('.zip')) {
          const el = document.getElementById('link-mac-zip');
          if (el) el.setAttribute('href', asset.browser_download_url);
        } else if (asset.name.endsWith('.exe')) {
          const el = document.getElementById('link-win-setup');
          if (el) el.setAttribute('href', asset.browser_download_url);
        } else if (asset.name.includes('Windows') && asset.name.endsWith('.zip')) {
          const el = document.getElementById('link-win-zip');
          if (el) el.setAttribute('href', asset.browser_download_url);
        }
      }
    } catch {
      // Keep static URLs
    }
  }

  refreshDirectDownloadUrls();
</script>

<style>
  .version-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    color: var(--text-2);
    margin-bottom: 1rem;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .download-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .download-cards-grid { grid-template-columns: 1fr; }
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.25rem;
  }

  .platform-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .platform-title {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-1);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .platform-sub {
    font-size: 0.82rem;
    color: var(--text-3);
  }

  .file-group {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .file-action-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    border-radius: 10px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    transition: all 0.2s;
    text-decoration: none;
  }

  .file-action-btn:hover {
    border-color: var(--border-strong);
    background: var(--bg-card-hover);
    transform: translateY(-1px);
  }

  .file-action-primary {
    border-color: var(--border-strong);
    background: var(--bg-card);
  }

  .file-action-btn strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text-1);
    margin-bottom: 0.2rem;
  }

  .file-meta {
    font-size: 0.78rem;
    color: var(--text-3);
  }

  .btn-action-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
    margin-left: 1rem;
  }

  .install-tip {
    font-size: 0.8rem;
    color: var(--text-2);
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  /* History Versions Card */
  .history-versions-card {
    margin-top: 2rem;
    padding: 1.75rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--bg-subtle);
  }

  @media (max-width: 860px) {
    .history-versions-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .history-actions {
      width: 100%;
      justify-content: flex-start;
    }
  }

  .history-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .history-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-2);
    flex-shrink: 0;
  }

  .history-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 0.25rem;
  }

  .history-desc {
    font-size: 0.84rem;
    color: var(--text-3);
    margin: 0;
  }

  .history-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-history {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.15rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none !important;
    color: var(--text-2) !important;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    transition: all 0.2s;
  }

  .btn-history:hover {
    color: var(--text-1) !important;
    border-color: var(--border-strong);
    background: var(--bg-card-hover);
    transform: translateY(-1px);
  }

  .btn-history-accent {
    color: var(--text-1) !important;
    border-color: var(--border-strong);
  }
</style>
