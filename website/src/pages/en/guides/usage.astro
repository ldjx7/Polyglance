---
import PageLayout from '../../../layouts/PageLayout.astro';
---

<PageLayout title="User Guide" description="Complete feature guide for Polyglance: Translation, OCR, Scrolling Capture, Recording & Preferences" lang="en">
  <div class="page-header">
    <h1 class="page-title">User Guide</h1>
    <p class="page-desc">Comprehensive walkthrough of features, workflows, interactions, and settings.</p>
  </div>

  <!-- 1. Selection Translation & In-Place Replacement -->
  <div class="card">
    <h2 class="card-title" style="display:flex; align-items:center; gap:0.6rem;">
      <span style="font-size:1.4rem;">📖</span> Selection Translation &amp; In-Place Replacement
    </h2>
    <p style="color:var(--text-2); font-size:0.95rem; line-height:1.7; margin-bottom:1.2rem;">
      Translate text directly across documents, web pages, and code editors without switching windows.
    </p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem; margin-bottom:1.2rem;">
      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Selection Translation (Floating Popover)</h3>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6; margin-bottom:0.5rem;">
          Select text and press default hotkey <kbd>⌥D</kbd> (macOS) or <kbd>Alt+D</kbd> (Windows).
        </p>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6;">
          A streaming translation popover appears near your cursor, auto-detects the source language, and copies translated text automatically.
        </p>
      </div>

      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Translate &amp; Replace (In-Place)</h3>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6; margin-bottom:0.5rem;">
          Select text in any editable area and press <kbd>⌥R</kbd> (macOS) or <kbd>Alt+R</kbd> (Windows).
        </p>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6;">
          Polyglance instantly translates the text and replaces the original selection in-place. Ideal for multilingual emails and code localization.
        </p>
      </div>
    </div>

    <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Key Capabilities</h3>
    <ul style="margin:0; padding-left:1.4rem; color:var(--text-2); font-size:0.92rem; line-height:1.8;">
      <li><strong>Auto Copy</strong>: Automatically syncs translated results to your system clipboard upon completion.</li>
      <li><strong>Pin Popover</strong>: Click the pin icon in the upper right to keep the translation popover floating on top.</li>
      <li><strong>Instant Language Switching</strong>: Click the language pill to toggle target languages or retry requests.</li>
    </ul>
  </div>

  <!-- 2. Offline OCR & Screen Translation -->
  <div class="card">
    <h2 class="card-title" style="display:flex; align-items:center; gap:0.6rem;">
      <span style="font-size:1.4rem;">🔍</span> Offline OCR &amp; Screen Translation
    </h2>
    <p style="color:var(--text-2); font-size:0.95rem; line-height:1.7; margin-bottom:1.2rem;">
      Recognize and translate non-selectable text from images, videos, protected web pages, and native apps.
    </p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem; margin-bottom:1.2rem;">
      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Screen Translation (Side-by-Side)</h3>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6; margin-bottom:0.5rem;">
          Press <kbd>⌥S</kbd> (macOS) or <kbd>Alt+S</kbd> (Windows) to capture any screen region.
        </p>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6;">
          Translated text directly overlays the source characters for natural contextual reading.
        </p>
      </div>

      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Text Recognition Workspace</h3>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6; margin-bottom:0.5rem;">
          Press <kbd>⌥C</kbd> (macOS) or <kbd>Alt+O</kbd> (Windows) to enter text selection mode.
        </p>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6;">
          Click highlighted words to copy, or press <kbd>Shift+C</kbd> to copy all extracted text.
        </p>
      </div>
    </div>

    <p style="color:var(--text-3); font-size:0.85rem; line-height:1.6;">
      Note: Powered by Apple Vision on macOS and Windows Media OCR on Windows. 100% on-device local computation with zero cloud transmission.
    </p>
  </div>

  <!-- 3. Screenshot & Drawing Toolkit -->
  <div class="card">
    <h2 class="card-title" style="display:flex; align-items:center; gap:0.6rem;">
      <span style="font-size:1.4rem;">✂️</span> Screenshot &amp; Drawing Toolkit
    </h2>
    <p style="color:var(--text-2); font-size:0.95rem; line-height:1.7; margin-bottom:1.2rem;">
      Smart window snapping and pixel-precise desktop annotation workflow.
    </p>

    <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; margin-bottom:1.2rem; border:1px solid var(--border-subtle);">
      <h3 style="font-size:0.98rem; font-weight:700; margin-bottom:0.6rem; color:var(--text-1);">Annotation Tools Overview</h3>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.75rem; color:var(--text-2); font-size:0.9rem;">
        <div>• <strong>Rectangles &amp; Ellipses</strong>: Highlight key elements</div>
        <div>• <strong>Arrows &amp; Lines</strong>: Guide focus</div>
        <div>• <strong>Freehand Pen</strong>: Sketch freely</div>
        <div>• <strong>Text Tool</strong>: Add typed callouts</div>
        <div>• <strong>Mosaic Blur</strong>: Obscure sensitive data</div>
        <div>• <strong>Numbered Badges</strong>: Sequence workflow steps</div>
      </div>
    </div>

    <ul style="margin:0; padding-left:1.4rem; color:var(--text-2); font-size:0.92rem; line-height:1.8;">
      <li><strong>Quick Capture</strong>: Press <kbd>⌥A</kbd> (macOS) or <kbd>Alt+C</kbd> (Windows) to capture, and press <kbd>Enter</kbd> to copy to clipboard.</li>
      <li><strong>Undo &amp; Redo</strong>: Use <kbd>Cmd+Z</kbd> / <kbd>Ctrl+Z</kbd> to undo and <kbd>Cmd+Shift+Z</kbd> / <kbd>Ctrl+Y</kbd> to redo.</li>
      <li><strong>Pixel Nudging</strong>: Use arrow keys to nudge selection boundaries by single pixels (hold Shift for 10 pixels).</li>
    </ul>
  </div>

  <!-- 4. Desktop Pinned Images -->
  <div class="card">
    <h2 class="card-title" style="display:flex; align-items:center; gap:0.6rem;">
      <span style="font-size:1.4rem;">📌</span> Desktop Pinned Images
    </h2>
    <p style="color:var(--text-2); font-size:0.95rem; line-height:1.7; margin-bottom:1.2rem;">
      Float reference images and clipboard pictures on top of all windows.
    </p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem; margin-bottom:1.2rem;">
      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Pin Triggers</h3>
        <ul style="margin:0; padding-left:1.2rem; color:var(--text-2); font-size:0.9rem; line-height:1.7;">
          <li><strong>Pin from Screenshot</strong>: Click the pin icon in the annotation toolbar.</li>
          <li><strong>Pin from Clipboard</strong>: Press <kbd>⌥W</kbd> (macOS) or <kbd>Alt+V</kbd> (Windows) to pin clipboard images immediately.</li>
          <li><strong>Restore Closed Pins</strong>: Press <kbd>⌥⇧W</kbd> (macOS) or <kbd>Alt+Shift+V</kbd> (Windows) to reopen dismissed pins.</li>
        </ul>
      </div>

      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Interactions</h3>
        <ul style="margin:0; padding-left:1.2rem; color:var(--text-2); font-size:0.9rem; line-height:1.7;">
          <li><strong>Zoom</strong>: Use mouse wheel to zoom smoothly; double click resets to 100% scale.</li>
          <li><strong>Annotate</strong>: Press <kbd>Space</kbd> to toggle drawing tools directly on the pinned image.</li>
          <li><strong>Context Menu</strong>: Right click for copy, save, pin history, and destroy options.</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- 5. Pixel Color Picker -->
  <div class="card">
    <h2 class="card-title" style="display:flex; align-items:center; gap:0.6rem;">
      <span style="font-size:1.4rem;">🎨</span> Pixel Precision Color Picker
    </h2>
    <p style="color:var(--text-2); font-size:0.95rem; line-height:1.7; margin-bottom:1rem;">
      Inspect exact pixel colors and coordinates on screen during UI design and frontend debugging.
    </p>

    <ul style="margin:0; padding-left:1.4rem; color:var(--text-2); font-size:0.92rem; line-height:1.8;">
      <li>Crosshair loupe magnifies pixel grid and displays real-time color values.</li>
      <li>Press <kbd>C</kbd>: Copy current pixel color value.</li>
      <li>Press <kbd>Shift+C</kbd>: Switch between HEX (e.g. <code>#0066CC</code>) and RGB (e.g. <code>rgb(0, 102, 204)</code>) formats.</li>
    </ul>
  </div>

  <!-- 6. Scrolling Long Screenshot -->
  <div class="card">
    <h2 class="card-title" style="display:flex; align-items:center; gap:0.6rem;">
      <span style="font-size:1.4rem;">📜</span> Scrolling Long Screenshot
    </h2>
    <p style="color:var(--text-2); font-size:0.95rem; line-height:1.7; margin-bottom:1.2rem;">
      Stitch long web pages, code listings, or chat histories into a single high-resolution image.
    </p>

    <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; margin-bottom:1rem; border:1px solid var(--border-subtle);">
      <ol style="margin:0; padding-left:1.4rem; color:var(--text-2); font-size:0.92rem; line-height:1.8;">
        <li>Enter screenshot mode, select the scrollable window or area, and click the Long Screenshot icon.</li>
        <li>Keep cursor inside the target area and scroll downward smoothly.</li>
        <li>The stitching algorithm aligns overlapping features and renders seamless composite frames.</li>
        <li>Click finish to crop, annotate, and export high-DPI images.</li>
      </ol>
    </div>
  </div>

  <!-- 7. Region Screen Recording -->
  <div class="card">
    <h2 class="card-title" style="display:flex; align-items:center; gap:0.6rem;">
      <span style="font-size:1.4rem;">🎥</span> Region Screen Recording (MP4 &amp; GIF)
    </h2>
    <p style="color:var(--text-2); font-size:0.95rem; line-height:1.7; margin-bottom:1.2rem;">
      Record crisp demonstrations and tutorials without bulky third-party video recording software.
    </p>

    <ul style="margin:0; padding-left:1.4rem; color:var(--text-2); font-size:0.92rem; line-height:1.8;">
      <li>Trigger recording from the screenshot toolbar or your custom shortcut.</li>
      <li>Select export format: <strong>GIF Animation</strong> (ideal for documentation) or <strong>MP4 High-Definition Video</strong>.</li>
      <li>Record system internal audio and microphone narration simultaneously.</li>
      <li>Finished recordings are encoded efficiently and can be copied or saved instantly.</li>
    </ul>
  </div>

  <!-- 8. Toolbar & Screen Recording Preferences -->
  <div class="card">
    <h2 class="card-title" style="display:flex; align-items:center; gap:0.6rem;">
      <span style="font-size:1.4rem;">⚙️</span> Dedicated Settings for Toolbar &amp; Recording
    </h2>
    <p style="color:var(--text-2); font-size:0.95rem; line-height:1.7; margin-bottom:1.2rem;">
      Tailor features and ergonomics in dedicated Preferences tabs:
    </p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem;">
      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Screenshot &amp; Recording Tab</h3>
        <ul style="margin:0; padding-left:1.2rem; color:var(--text-2); font-size:0.9rem; line-height:1.7;">
          <li><strong>Format &amp; Frame Rate</strong>: Set default video/GIF output and adjust recording FPS.</li>
          <li><strong>Audio Source Selection</strong>: Toggle system audio loopback and select microphone inputs.</li>
          <li><strong>Stitching Sensitivity</strong>: Fine-tune feature alignment tolerance for long screenshots.</li>
        </ul>
      </div>

      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Toolbar Settings Tab</h3>
        <ul style="margin:0; padding-left:1.2rem; color:var(--text-2); font-size:0.9rem; line-height:1.7;">
          <li><strong>Toolbar Scaling</strong>: Dynamically scale toolbar button and icon size for high-DPI screens.</li>
          <li><strong>Alignment &amp; Centering</strong>: Automatically center toolbar and avoid screen edge clipping.</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- 9. Translation Providers -->
  <div class="card">
    <h2 class="card-title" style="display:flex; align-items:center; gap:0.6rem;">
      <span style="font-size:1.4rem;">🌐</span> Translation Providers &amp; LLM Configuration
    </h2>
    <p style="color:var(--text-2); font-size:0.95rem; line-height:1.7; margin-bottom:1.2rem;">
      Polyglance offers zero-config free endpoints and native integration with custom LLMs.
    </p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem;">
      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Zero-Config Default Mode</h3>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6;">
          Built-in Microsoft, Google, and Free AI services work out of the box. No account registration, API keys, or proxy setup required.
        </p>
      </div>

      <div style="background:var(--bg-subtle); border-radius:10px; padding:1.2rem; border:1px solid var(--border-subtle);">
        <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem; color:var(--text-1);">Custom LLMs (OpenAI-Compatible)</h3>
        <p style="color:var(--text-2); font-size:0.9rem; line-height:1.6;">
          Connect DeepSeek, OpenAI, Groq, or local Ollama endpoints in Preferences &rarr; Providers to leverage contextual LLM intelligence.
        </p>
      </div>
    </div>
  </div>
</PageLayout>
