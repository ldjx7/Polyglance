---
import PageLayout from '../../../layouts/PageLayout.astro';
---

<PageLayout title="Keyboard Shortcuts" description="Default global shortcut bindings and controls in Polyglance" lang="en">
  <div class="page-header">
    <h1 class="page-title">Keyboard Shortcuts</h1>
    <p class="page-desc">All global shortcuts can be customized in Preferences.</p>
  </div>

  <div class="card">
    <h2 class="card-title">Core Global Shortcuts</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>Action</th>
          <th>macOS Default</th>
          <th>Windows Default</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Screenshot Tool</strong> (Region capture, annotate &amp; pin)</td>
          <td><kbd>⌃ Control</kbd> + <kbd>⇧ Shift</kbd> + <kbd>1</kbd></td>
          <td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>1</kbd></td>
        </tr>
        <tr>
          <td><strong>Pin Clipboard Image</strong> (Float clipboard image on desktop)</td>
          <td><kbd>⌃ Control</kbd> + <kbd>⇧ Shift</kbd> + <kbd>2</kbd></td>
          <td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>2</kbd></td>
        </tr>
        <tr>
          <td><strong>Selected Text Translation</strong> (Floating translation popover)</td>
          <td><kbd>⌃ Control</kbd> + <kbd>⇧ Shift</kbd> + <kbd>3</kbd></td>
          <td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>3</kbd></td>
        </tr>
        <tr>
          <td><strong>Screen Translation</strong> (Select region for OCR &amp; translation)</td>
          <td><kbd>⌃ Control</kbd> + <kbd>⇧ Shift</kbd> + <kbd>4</kbd></td>
          <td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>4</kbd></td>
        </tr>
        <tr>
          <td><strong>Restore Recently Closed Pin</strong> (Recover closed pinned images)</td>
          <td><kbd>⌃ Control</kbd> + <kbd>⇧ Shift</kbd> + <kbd>5</kbd></td>
          <td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>5</kbd></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">Optional Actions (Customizable)</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>Action</th>
          <th>Default</th>
          <th>Configuration Note</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Open Main Translator Window</strong></td>
          <td><span style="color:var(--text-3);">Unassigned</span></td>
          <td>Record and bind custom key in Preferences &rarr; Shortcuts</td>
        </tr>
        <tr>
          <td><strong>Scrolling Long Screenshot</strong></td>
          <td><span style="color:var(--text-3);">Unassigned</span></td>
          <td>Record and bind custom key in Preferences &rarr; Shortcuts</td>
        </tr>
        <tr>
          <td><strong>Region Screen Recording (MP4 / GIF)</strong></td>
          <td><span style="color:var(--text-3);">Unassigned</span></td>
          <td>Record and bind custom key in Preferences &rarr; Shortcuts</td>
        </tr>
        <tr>
          <td><strong>Read Selected Text Only (No Auto-Translate)</strong></td>
          <td><span style="color:var(--text-3);">Unassigned</span></td>
          <td>Record and bind custom key in Preferences &rarr; Shortcuts</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">Screenshot Selection &amp; Annotation</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>Action</th>
          <th>Shortcut / Input</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Confirm &amp; Copy</strong></td>
          <td><kbd>Enter</kbd></td>
          <td>Save annotated region to clipboard</td>
        </tr>
        <tr>
          <td><strong>Cancel / Exit</strong></td>
          <td><kbd>Esc</kbd></td>
          <td>Exit screenshot or cancel active selection</td>
        </tr>
        <tr>
          <td><strong>Delete Selected Element</strong></td>
          <td><kbd>Delete</kbd> / <kbd>Backspace</kbd></td>
          <td>Remove selected annotation item</td>
        </tr>
        <tr>
          <td><strong>Nudge Selection</strong></td>
          <td><kbd>&uarr;</kbd> <kbd>&darr;</kbd> <kbd>&larr;</kbd> <kbd>&rarr;</kbd></td>
          <td>Move selection by 1px (hold <kbd>Shift</kbd> for 10px)</td>
        </tr>
        <tr>
          <td><strong>Undo Annotation</strong></td>
          <td><kbd>⌘ Cmd</kbd> / <kbd>Ctrl</kbd> + <kbd>Z</kbd></td>
          <td>Undo last drawing action</td>
        </tr>
        <tr>
          <td><strong>Redo Annotation</strong></td>
          <td><kbd>⌘ Cmd</kbd> + <kbd>⇧ Shift</kbd> + <kbd>Z</kbd> / <kbd>Ctrl</kbd> + <kbd>Y</kbd></td>
          <td>Redo undone drawing action</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">Color Picker &amp; Pinned Images</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>Context</th>
          <th>Shortcut / Interaction</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Pick Color</strong></td>
          <td><kbd>C</kbd></td>
          <td>Copy pixel color at crosshair</td>
        </tr>
        <tr>
          <td><strong>Toggle Color Format</strong></td>
          <td><kbd>⇧ Shift</kbd> + <kbd>C</kbd></td>
          <td>Switch between HEX and RGB formats</td>
        </tr>
        <tr>
          <td><strong>Edit Pin Annotation</strong></td>
          <td><kbd>Space</kbd></td>
          <td>Toggle drawing toolbar on pinned image</td>
        </tr>
        <tr>
          <td><strong>Zoom Pinned Image</strong></td>
          <td>Mouse Wheel / Double Click</td>
          <td>Zoom continuously or reset scale</td>
        </tr>
        <tr>
          <td><strong>Context Menu</strong></td>
          <td>Right Click</td>
          <td>Open menu: Copy, Save, History, Close</td>
        </tr>
        <tr>
          <td><strong>Close Pin</strong></td>
          <td><kbd>Esc</kbd></td>
          <td>Close active pin when not editing</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">Offline OCR Text Extraction</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>Action</th>
          <th>Shortcut / Input</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Select Text Blocks</strong></td>
          <td>Drag / Click Word</td>
          <td>Highlight specific line or single word</td>
        </tr>
        <tr>
          <td><strong>Copy Selected Text</strong></td>
          <td><kbd>⌘ Cmd</kbd> / <kbd>Ctrl</kbd> + <kbd>C</kbd></td>
          <td>Copy selected words to clipboard</td>
        </tr>
        <tr>
          <td><strong>Copy All Recognized Text</strong></td>
          <td><kbd>⇧ Shift</kbd> + <kbd>C</kbd></td>
          <td>Copy entire recognized text within region</td>
        </tr>
        <tr>
          <td><strong>Exit OCR View</strong></td>
          <td><kbd>Esc</kbd></td>
          <td>Dismiss OCR results popover</td>
        </tr>
      </tbody>
    </table>
  </div>
</PageLayout>
