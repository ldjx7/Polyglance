{
  "name": "polyglance-website",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "test": "node --test functions/**/*.test.ts",
    "typecheck": "wrangler types && tsc --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler pages deploy dist --project-name polyglance --branch main"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.36.3",
    "astro": "^5.13.5",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "wrangler": "^4.127.1"
  }
}
